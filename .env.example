# ============================================================
# Maa Laxmi Property — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env — it is in .gitignore.
# ============================================================

# --- Site ----------------------------------------------------
SITE_URL=http://localhost:4321

# --- Database (Docker Compose) --------------------------------
DATABASE_URL=postgresql://mlp:mlp_dev@localhost:5432/mlp_dev

# --- Authentication (Better Auth) ----------------------------
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:4321

# --- Admin Seed (used by seed script only) --------------------
ADMIN_EMAIL=admin@demo.example
ADMIN_PASSWORD=demo-password

# --- Contact Details (optional — buttons disabled when absent) -
# CONTACT_PHONE=
# CONTACT_WHATSAPP=
# CONTACT_EMAIL=

# --- Google Maps (optional — Leaflet/OSM fallback) ------------
# GOOGLE_MAPS_API_KEY=
