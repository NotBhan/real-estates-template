---
import { config } from '@/lib/config';
import { ArrowRight, Search } from '@lucide/astro';
---

<section
  class="relative min-h-[100svh] flex items-center justify-center bg-bg-primary overflow-hidden"
  aria-label="Hero"
>
  <!-- Background image with overlay -->
  <div class="absolute inset-0">
    <!-- Demo: using a CSS gradient as hero background until actual property images are available -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, #0B0E14 0%, #151922 40%, #1a1f2e 70%, #0B0E14 100%);"
      role="img"
      aria-label="Architectural background"
    >
    </div>
    <!-- Subtle decorative element -->
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: radial-gradient(circle at 30% 50%, rgba(212, 175, 55, 0.3) 0%, transparent 60%), radial-gradient(circle at 70% 30%, rgba(212, 175, 55, 0.15) 0%, transparent 50%);"
    >
    </div>
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-site text-center px-4 py-32 md:py-40">
    <!-- Kicker -->
    <p class="kicker mb-6 tracking-[0.2em]" id="hero-kicker">
      {config.brand.name}
    </p>

    <!-- Headline -->
    <h1 class="heading-hero max-w-4xl mx-auto mb-6" id="hero-heading">
      {config.brand.tagline}
    </h1>

    <!-- Supporting text -->
    <p
      class="text-text-light text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed"
      id="hero-description"
    >
      Discover residential, commercial, and land properties with trusted
      guidance. Browse our listings and find your next property today.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4" id="hero-ctas">
      <a href="/properties" class="btn btn-primary text-base px-8 py-3.5">
        <Search size={18} />
        Explore Properties
      </a>
      <a href="/contact" class="btn btn-outline text-base px-8 py-3.5">
        Contact Us
        <ArrowRight size={18} />
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
      <div class="w-6 h-10 rounded-full border-2 border-white/20 flex items-start justify-center p-1.5">
        <div class="w-1 h-2.5 bg-white/40 rounded-full animate-bounce"></div>
      </div>
    </div>
  </div>
</section>
