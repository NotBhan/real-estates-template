---
import { config } from '@/lib/config';
import { MapPin, Phone, Mail, ArrowUpRight } from '@lucide/astro';

const currentYear = new Date().getFullYear();

const propertyLinks = [
  { label: 'Residential', href: '/properties?type=Residential' },
  { label: 'Commercial', href: '/properties?type=Commercial' },
  { label: 'Land', href: '/properties?type=Land' },
  { label: 'Plots', href: '/properties?type=Plot' },
  { label: 'Flats', href: '/properties?type=Flat' },
  { label: 'Villas', href: '/properties?type=Villa' },
];

const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-bg-primary text-text-on-dark" role="contentinfo">
  <!-- Main footer content -->
  <div class="container-site section-padding">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 no-underline mb-4">
          <span class="text-accent font-extrabold text-2xl">ML</span>
          <span class="text-white font-bold text-lg">{config.brand.name}</span>
        </a>
        <p class="text-body--light text-sm mt-3 max-w-xs">
          {/* Demo description — will be replaced with actual client content */}
          Your trusted property consultant for residential, commercial,
          and land properties. Helping you find the right property with
          transparency and dedication.
        </p>
      </div>

      <!-- Properties column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Properties
        </h3>
        <ul class="space-y-2.5" role="list">
          {propertyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-text-light text-sm hover:text-accent transition-colors duration-200 no-underline inline-flex items-center gap-1"
              >
                {link.label}
                <ArrowUpRight size={12} class="opacity-0 group-hover:opacity-100 transition-opacity" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Company
        </h3>
        <ul class="space-y-2.5" role="list">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-text-light text-sm hover:text-accent transition-colors duration-200 no-underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Contact
        </h3>
        <ul class="space-y-3" role="list">
          <li class="flex items-start gap-3 text-sm text-text-light">
            <MapPin size={16} class="text-accent mt-0.5 shrink-0" />
            <span>
              {/* Demo address — actual address pending from client */}
              <span class="text-text-light/60 italic">Address pending from client</span>
            </span>
          </li>
          <li class="flex items-center gap-3 text-sm text-text-light">
            <Phone size={16} class="text-accent shrink-0" />
            {config.contactPhone ? (
              <a href={`tel:${config.contactPhone}`} class="hover:text-accent transition-colors no-underline">
                {config.contactPhone}
              </a>
            ) : (
              <span class="text-text-light/60 italic">Phone pending</span>
            )}
          </li>
          <li class="flex items-center gap-3 text-sm text-text-light">
            <Mail size={16} class="text-accent shrink-0" />
            {config.contactEmail ? (
              <a href={`mailto:${config.contactEmail}`} class="hover:text-accent transition-colors no-underline">
                {config.contactEmail}
              </a>
            ) : (
              <span class="text-text-light/60 italic">Email pending</span>
            )}
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-border">
    <div class="container-site py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-text-light text-xs">
        &copy; {currentYear} {config.brand.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-text-light text-xs hover:text-accent transition-colors no-underline">
          Privacy Policy
        </a>
        <a href="#" class="text-text-light text-xs hover:text-accent transition-colors no-underline">
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>
