---
import { config } from '@/lib/config';
import { MapPin, Phone, Mail, ArrowUpRight } from '@lucide/astro';

const currentYear = new Date().getFullYear();

const propertyLinks = [
  { label: 'Residential', href: '/properties?type=Residential' },
  { label: 'Commercial', href: '/properties?type=Commercial' },
  { label: 'Land', href: '/properties?type=Land' },
  { label: 'Plots', href: '/properties?type=Plot' },
  { label: 'Flats', href: '/properties?type=Flat' },
  { label: 'Villas', href: '/properties?type=Villa' },
];

const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-bg-primary text-slate-200 border-t border-white/10 relative overflow-hidden" role="contentinfo">
  <!-- Subtle ambient glow -->
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[300px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Main footer content -->
  <div class="container-site section-padding relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 no-underline mb-5 group">
          <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-500 flex items-center justify-center text-white font-black text-lg shadow-lg shadow-blue-500/20">
            ML
          </span>
          <span class="text-gradient-silver font-bold text-xl">{config.brand.name}</span>
        </a>
        <p class="text-slate-400 text-sm mt-3 max-w-xs font-light leading-relaxed">
          Your trusted property consultant for residential, commercial,
          and land properties in Delhi NCR. Redefining architectural discovery with integrity.
        </p>
      </div>

      <!-- Properties column -->
      <div>
        <h3 class="text-white font-semibold text-xs uppercase tracking-[0.15em] text-blue-400 mb-5">
          Properties
        </h3>
        <ul class="space-y-3" role="list">
          {propertyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-400 text-sm hover:text-blue-300 transition-colors duration-200 no-underline inline-flex items-center gap-1.5 group"
              >
                <span>{link.label}</span>
                <ArrowUpRight size={13} class="opacity-0 group-hover:opacity-100 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all text-blue-400" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company column -->
      <div>
        <h3 class="text-white font-semibold text-xs uppercase tracking-[0.15em] text-blue-400 mb-5">
          Company
        </h3>
        <ul class="space-y-3" role="list">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-400 text-sm hover:text-blue-300 transition-colors duration-200 no-underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h3 class="text-white font-semibold text-xs uppercase tracking-[0.15em] text-blue-400 mb-5">
          Contact
        </h3>
        <ul class="space-y-3.5" role="list">
          <li class="flex items-start gap-3 text-sm text-slate-400">
            <MapPin size={16} class="text-blue-400 mt-0.5 shrink-0" />
            <span>
              <span class="text-slate-500 italic">Address pending from client</span>
            </span>
          </li>
          <li class="flex items-center gap-3 text-sm text-slate-400">
            <Phone size={16} class="text-blue-400 shrink-0" />
            {config.contactPhone ? (
              <a href={`tel:${config.contactPhone}`} class="hover:text-blue-300 transition-colors no-underline">
                {config.contactPhone}
              </a>
            ) : (
              <span class="text-slate-500 italic">Phone pending</span>
            )}
          </li>
          <li class="flex items-center gap-3 text-sm text-slate-400">
            <Mail size={16} class="text-blue-400 shrink-0" />
            {config.contactEmail ? (
              <a href={`mailto:${config.contactEmail}`} class="hover:text-blue-300 transition-colors no-underline">
                {config.contactEmail}
              </a>
            ) : (
              <span class="text-slate-500 italic">Email pending</span>
            )}
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10 relative z-10">
    <div class="container-site py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-xs">
        &copy; {currentYear} {config.brand.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-slate-500 text-xs hover:text-slate-300 transition-colors no-underline">
          Privacy Policy
        </a>
        <a href="#" class="text-slate-500 text-xs hover:text-slate-300 transition-colors no-underline">
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>
