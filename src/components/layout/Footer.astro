---
import { config } from '@/lib/config';
import { MapPin, Phone, Mail, ArrowUpRight } from '@lucide/astro';

const currentYear = new Date().getFullYear();

const propertyLinks = [
  { label: 'Residential', href: '/properties?type=Residential' },
  { label: 'Commercial', href: '/properties?type=Commercial' },
  { label: 'Land', href: '/properties?type=Land' },
  { label: 'Plots', href: '/properties?type=Plot' },
  { label: 'Flats', href: '/properties?type=Flat' },
  { label: 'Villas', href: '/properties?type=Villa' },
];

const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-surface-dark text-stone-200 border-t border-stone-800 relative overflow-hidden" role="contentinfo">
  <!-- Prominent Final CTA Section -->
  <div class="border-b border-stone-800/80 py-14 sm:py-20">
    <div class="container-site text-center max-w-3xl mx-auto">
      <div class="eyebrow-label mb-3 justify-center">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
        <span class="text-brand-gold">Get Started</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-6">
        Find a place worth calling home.
      </h2>
      <p class="text-stone-400 text-base md:text-lg mb-8 font-light leading-relaxed">
        Speak with our property consultants today or browse our handpicked collection of residential, commercial, and investment holdings.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {config.contactPhone ? (
          <a href={`tel:${config.contactPhone}`} class="btn btn-action-blue text-base px-8 py-3.5 rounded-full w-full sm:w-auto font-semibold">
            <Phone size={16} />
            Call Now
          </a>
        ) : (
          <a href="/contact" class="btn btn-action-blue text-base px-8 py-3.5 rounded-full w-full sm:w-auto font-semibold">
            <Phone size={16} />
            Call Now
          </a>
        )}
        <a href="/properties" class="btn btn-dark-outline text-base px-8 py-3.5 rounded-full w-full sm:w-auto font-semibold">
          Explore Properties
        </a>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="container-site section-padding relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 no-underline mb-4 group">
          <span class="w-9 h-9 rounded-full bg-white text-ink font-black text-xs tracking-widest flex items-center justify-center shadow-xs">
            {config.brandInitials}
          </span>
          <span class="font-bold text-xl text-white tracking-tight">{config.siteName}</span>
        </a>
        <p class="text-stone-400 text-sm mt-2 max-w-xs font-light leading-relaxed">
          A premium real-estate website template crafted for residential, commercial, and land portfolios. Demonstrating refined property discovery with architectural elegance.
        </p>
      </div>

      <!-- Properties column -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-[0.18em] mb-4">
          Properties
        </h3>
        <ul class="space-y-2.5" role="list">
          {propertyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-stone-400 text-sm hover:text-white transition-colors duration-200 no-underline inline-flex items-center gap-1 group"
              >
                <span>{link.label}</span>
                <ArrowUpRight size={13} class="opacity-0 group-hover:opacity-100 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all text-brand-gold" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company column -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-[0.18em] mb-4">
          Company
        </h3>
        <ul class="space-y-2.5" role="list">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-stone-400 text-sm hover:text-white transition-colors duration-200 no-underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-[0.18em] mb-4">
          Contact
        </h3>
        <ul class="space-y-3" role="list">
          <li class="flex items-start gap-3 text-sm text-stone-400">
            <MapPin size={16} class="text-brand-gold mt-0.5 shrink-0" />
            <span class="text-stone-300">
              {config.address}
            </span>
          </li>
          <li class="flex items-center gap-3 text-sm text-stone-400">
            <Phone size={16} class="text-brand-gold shrink-0" />
            {config.contactPhone ? (
              <a href={`tel:${config.contactPhone}`} class="hover:text-white transition-colors no-underline">
                {config.contactPhone}
              </a>
            ) : (
              <a href="/contact" class="hover:text-white transition-colors no-underline text-stone-300">
                Advisory Consultation Line
              </a>
            )}
          </li>
          <li class="flex items-center gap-3 text-sm text-stone-400">
            <Mail size={16} class="text-brand-gold shrink-0" />
            {config.contactEmail ? (
              <a href={`mailto:${config.contactEmail}`} class="hover:text-white transition-colors no-underline">
                {config.contactEmail}
              </a>
            ) : (
              <a href="/contact" class="hover:text-white transition-colors no-underline text-stone-300">
                Client Advisory Desk
              </a>
            )}
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-stone-800/80 relative z-10">
    <div class="container-site py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <div class="space-y-1">
        <p class="text-stone-500 text-xs">
          &copy; {currentYear} {config.siteName}. All rights reserved.
        </p>
        <p class="text-stone-500/80 text-[11px] font-light">
          {config.demoDisclosure}
        </p>
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-stone-400 text-xs hover:text-white transition-colors no-underline">
          Privacy Policy
        </a>
        <a href="/terms" class="text-stone-400 text-xs hover:text-white transition-colors no-underline">
          Terms of Service
        </a>
      </div>
    </div>
  </div>
</footer>
