---
import { config } from '@/lib/config';
import { Phone, Menu, X } from '@lucide/astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Properties', href: '/properties' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out py-4"
>
  <nav
    class="container-site flex items-center justify-between h-16 px-6 rounded-full transition-all duration-300"
    id="nav-inner"
    aria-label="Main navigation"
  >
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-3 text-white font-extrabold text-xl tracking-tight no-underline group"
      aria-label={`${config.brand.name} — Home`}
    >
      <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-500 flex items-center justify-center text-white font-black text-lg shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform duration-300">
        ML
      </span>
      <span class="hidden sm:inline font-sans text-gradient-silver tracking-tight group-hover:text-white transition-colors">{config.brand.name}</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-2" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'relative px-4 py-2 text-sm font-medium transition-colors duration-200 no-underline group',
              currentPath === link.href
                ? 'text-blue-400 font-semibold'
                : 'text-slate-300 hover:text-white',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
            <span
              class:list={[
                'absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full transition-all duration-300 transform origin-left',
                currentPath === link.href ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
              ]}
            />
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA + Mobile menu button -->
    <div class="flex items-center gap-3">
      {config.contactPhone ? (
        <a
          href={`tel:${config.contactPhone}`}
          class="btn btn-electric hidden lg:inline-flex text-xs uppercase tracking-wider font-semibold rounded-full px-5 py-2.5"
        >
          <Phone size={15} />
          Call Now
        </a>
      ) : (
        <span class="btn btn-electric hidden lg:inline-flex text-xs uppercase tracking-wider font-semibold rounded-full px-5 py-2.5 opacity-70 cursor-default" title="Phone number pending">
          <Phone size={15} />
          Call Now
        </span>
      )}

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white rounded-full bg-white/5 border border-white/10 hover:bg-white/10 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Menu id="menu-icon-open" size={22} />
        <X id="menu-icon-close" size={22} class="hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="lg:hidden absolute top-full left-0 right-0 h-[calc(100dvh-5rem)] bg-gray-950/95 backdrop-blur-xl border-t border-white/10 transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
    aria-hidden="true"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col items-center gap-3 pt-8 px-6" role="list">
      {navLinks.map((link) => (
        <li class="w-full">
          <a
            href={link.href}
            class:list={[
              'block w-full text-center py-3.5 text-lg font-medium rounded-xl transition-all duration-200 no-underline',
              currentPath === link.href
                ? 'text-blue-400 bg-blue-500/10 border border-blue-500/20'
                : 'text-slate-300 hover:text-white hover:bg-white/5',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="w-full pt-4">
        {config.contactPhone ? (
          <a
            href={`tel:${config.contactPhone}`}
            class="btn btn-electric w-full justify-center rounded-xl py-3 text.sm"
          >
            <Phone size={16} />
            Call Now
          </a>
        ) : (
          <span class="btn btn-electric w-full justify-center rounded-xl py-3 text-sm opacity-70 cursor-default" title="Phone number pending">
            <Phone size={16} />
            Call Now
          </span>
        )}
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggle && menu && iconOpen && iconClose) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.setAttribute('aria-hidden', String(isOpen));
      menu.classList.toggle('translate-x-full', isOpen);
      menu.classList.toggle('translate-x-0', !isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }

  // Navbar scroll behavior: apply floating pill glass style on scroll
  const navInner = document.getElementById('nav-inner');
  if (navInner) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        navInner.classList.add('glass-nav', 'shadow-2xl', 'shadow-blue-950/40');
        navInner.classList.remove('bg-transparent');
      } else {
        navInner.classList.remove('glass-nav', 'shadow-2xl', 'shadow-blue-950/40');
        navInner.classList.add('bg-transparent');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  #site-navbar:has(#mobile-menu.translate-x-0) {
    background-color: var(--color-bg-primary);
  }
</style>
