---
import { config } from '@/lib/config';
import { Phone, Menu, X } from '@lucide/astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Properties', href: '/properties' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out py-3 md:py-4 px-3 sm:px-6"
>
  <nav
    id="nav-inner"
    class="max-w-6xl mx-auto flex items-center justify-between h-16 px-6 rounded-full transition-all duration-500 border border-transparent"
    aria-label="Main navigation"
  >
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-3 text-ink font-bold text-lg sm:text-xl tracking-tight no-underline group"
      aria-label={`${config.brand.name} — Home`}
    >
      <span class="w-9 h-9 rounded-full bg-ink text-canvas flex items-center justify-center font-black text-xs tracking-widest shadow-sm group-hover:bg-action-blue transition-colors duration-300">
        ML
      </span>
      <span class="font-sans font-semibold tracking-tight text-current group-hover:text-action-blue transition-colors duration-300">
        {config.brand.name}
      </span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'relative px-4 py-2 text-sm font-medium transition-colors duration-300 no-underline group inline-block',
              currentPath === link.href
                ? 'text-action-blue font-semibold'
                : 'text-current opacity-85 hover:opacity-100 hover:text-action-blue',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
            <span
              class:list={[
                'absolute bottom-1 left-4 right-4 h-0.5 bg-action-blue rounded-full transition-all duration-300 transform origin-left',
                currentPath === link.href ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
              ]}
            />
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA + Mobile menu button -->
    <div class="flex items-center gap-3">
      {config.contactPhone ? (
        <a
          href={`tel:${config.contactPhone}`}
          class="btn btn-action-blue hidden lg:inline-flex text-xs uppercase tracking-wider font-semibold rounded-full px-5 py-2.5"
        >
          <Phone size={14} />
          Call Now
        </a>
      ) : (
        <span class="btn btn-action-blue hidden lg:inline-flex text-xs uppercase tracking-wider font-semibold rounded-full px-5 py-2.5 opacity-70 cursor-default" title="Phone number pending">
          <Phone size={14} />
          Call Now
        </span>
      )}

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-stone-200/60 border border-stone-300/80 text-ink hover:bg-stone-300/80 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Menu id="menu-icon-open" size={20} />
        <X id="menu-icon-close" size={20} class="hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-4 top-20 bg-white/95 backdrop-blur-xl border border-stone-200 shadow-2xl rounded-2xl p-6 transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-editorial"
    aria-hidden="true"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col gap-2" role="list">
      {navLinks.map((link) => (
        <li class="w-full">
          <a
            href={link.href}
            class:list={[
              'block w-full py-3 px-4 text-base font-semibold rounded-xl transition-all duration-200 no-underline',
              currentPath === link.href
                ? 'text-action-blue bg-stone-100'
                : 'text-ink hover:bg-stone-50',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="w-full pt-3 border-t border-stone-200 mt-2">
        {config.contactPhone ? (
          <a
            href={`tel:${config.contactPhone}`}
            class="btn btn-action-blue w-full justify-center rounded-xl py-3 text-sm"
          >
            <Phone size={16} />
            Call Now
          </a>
        ) : (
          <span class="btn btn-action-blue w-full justify-center rounded-xl py-3 text-sm opacity-70 cursor-default" title="Phone number pending">
            <Phone size={16} />
            Call Now
          </span>
        )}
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggle && menu && iconOpen && iconClose) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.setAttribute('aria-hidden', String(isOpen));
      menu.classList.toggle('-translate-y-full', isOpen);
      menu.classList.toggle('translate-y-0', !isOpen);
      menu.classList.toggle('opacity-0', isOpen);
      menu.classList.toggle('opacity-100', !isOpen);
      menu.classList.toggle('pointer-events-none', isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
    });
  }

  // Navbar scroll behavior
  const navInner = document.getElementById('nav-inner');
  if (navInner) {
    const onScroll = () => {
      if (window.scrollY > 30) {
        navInner.classList.add('bg-white/90', 'backdrop-blur-md', 'border-stone-200/80', 'shadow-editorial', 'text-ink');
        navInner.classList.remove('bg-transparent', 'border-transparent');
      } else {
        navInner.classList.remove('bg-white/90', 'backdrop-blur-md', 'border-stone-200/80', 'shadow-editorial');
        navInner.classList.add('bg-transparent', 'border-transparent');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
