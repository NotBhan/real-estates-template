---
import { config } from '@/lib/config';
import { Phone, Menu, X } from '@lucide/astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Properties', href: '/properties' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out"
>
  <nav
    class="container-site flex items-center justify-between h-20"
    aria-label="Main navigation"
  >
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2 text-white font-bold text-lg tracking-tight no-underline"
      aria-label={`${config.brand.name} — Home`}
    >
      <span class="text-accent font-extrabold text-xl">ML</span>
      <span class="hidden sm:inline">{config.brand.name}</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-md transition-colors duration-200 no-underline',
              currentPath === link.href
                ? 'text-accent'
                : 'text-white/80 hover:text-white',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA + Mobile menu button -->
    <div class="flex items-center gap-3">
      {config.contactPhone ? (
        <a
          href={`tel:${config.contactPhone}`}
          class="btn btn-primary hidden lg:inline-flex text-sm"
        >
          <Phone size={16} />
          Call Now
        </a>
      ) : (
        <span class="btn btn-primary hidden lg:inline-flex text-sm opacity-60 cursor-default" title="Phone number pending">
          <Phone size={16} />
          Call Now
        </span>
      )}

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white rounded-md hover:bg-white/10 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Menu id="menu-icon-open" size={24} />
        <X id="menu-icon-close" size={24} class="hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="lg:hidden absolute top-full left-0 right-0 h-[calc(100dvh-5rem)] bg-bg-primary backdrop-blur-md transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
    aria-hidden="true"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col items-center gap-2 pt-8 px-6" role="list">
      {navLinks.map((link) => (
        <li class="w-full">
          <a
            href={link.href}
            class:list={[
              'block w-full text-center py-3 text-lg font-medium rounded-lg transition-colors duration-200 no-underline',
              currentPath === link.href
                ? 'text-accent bg-white/5'
                : 'text-white/80 hover:text-white hover:bg-white/5',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="w-full pt-4">
        {config.contactPhone ? (
          <a
            href={`tel:${config.contactPhone}`}
            class="btn btn-primary w-full justify-center"
          >
            <Phone size={16} />
            Call Now
          </a>
        ) : (
          <span class="btn btn-primary w-full justify-center opacity-60 cursor-default" title="Phone number pending">
            <Phone size={16} />
            Call Now
          </span>
        )}
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggle && menu && iconOpen && iconClose) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.setAttribute('aria-hidden', String(isOpen));
      menu.classList.toggle('translate-x-full', isOpen);
      menu.classList.toggle('translate-x-0', !isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }

  // Navbar scroll behavior: add background on scroll
  const navbar = document.getElementById('site-navbar');
  if (navbar) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        navbar.classList.add('bg-bg-primary/95', 'backdrop-blur-md', 'shadow-lg', 'shadow-black/10');
      } else {
        navbar.classList.remove('bg-bg-primary/95', 'backdrop-blur-md', 'shadow-lg', 'shadow-black/10');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // run on load
  }
</script>

<style>
  #site-navbar:has(#mobile-menu.translate-x-0) {
    background-color: var(--color-bg-primary);
  }
</style>
