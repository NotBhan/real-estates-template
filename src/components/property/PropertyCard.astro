---
/**
 * PropertyCard — Bright Luxury Editorial Property Card
 *
 * Renders property-type-appropriate metadata:
 * - Residential / Flat / Villa → bedrooms, bathrooms, area
 * - Commercial → commercial type, area
 * - Land / Plot → area, facing
 *
 * Links to /properties/[slug].
 */
import {
  type Property,
  hasRoomInfo,
  isCommercial,
  isLandLike,
} from '@/types/property';
import { formatPrice, formatArea } from '@/lib/format';
import { MapPin, BedDouble, Bath, Maximize, Building2, Compass, ArrowRight } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;

const displayPrice = formatPrice(property.price, property.priceInterval);
const displayArea = formatArea(property.area.value, property.area.unit);
const primaryImage = property.images[0];
const href = `/properties/${property.slug}`;

const isSold = property.status === 'Sold' || property.status === 'Rented';
---

<article
  class="group relative flex flex-col rounded-2xl overflow-hidden bg-white border border-stone-200/90 shadow-sm hover:shadow-editorial hover:-translate-y-1.5 transition-all duration-500 h-full"
  id={`property-card-${property.id}`}
>
  {/* ---- Image area ---- */}
  <a
    href={href}
    class="relative block aspect-[16/10] overflow-hidden bg-stone-100"
    aria-label={`View ${property.title}`}
    tabindex="-1"
  >
    {primaryImage ? (
      <img
        src={primaryImage.url}
        alt={primaryImage.alt}
        class:list={[
          'h-full w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-105',
          isSold && 'opacity-70 filter grayscale-[0.3]',
        ]}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div
        class="h-full w-full bg-stone-200 flex items-center justify-center"
        role="img"
        aria-label="No image available"
      >
        <span class="text-muted text-sm font-medium">No Image</span>
      </div>
    )}

    {/* Subtle gradient overlay for badge readability */}
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-black/40 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

    {/* Top badge strip */}
    <div class="absolute top-3 left-3 right-3 flex items-start justify-between pointer-events-none z-10">
      {/* Property type badge */}
      <span class="inline-flex items-center gap-1 rounded-full bg-white/95 backdrop-blur-md border border-stone-200/80 px-3 py-1 text-xs font-bold text-ink shadow-xs">
        {property.propertyType}
      </span>

      {/* Status badge */}
      <span
        class:list={[
          'inline-flex items-center rounded-full px-3 py-1 text-xs font-bold shadow-xs',
          property.status === 'Available'
            ? 'bg-action-blue text-white'
            : property.status === 'Sold'
              ? 'bg-rose-700 text-white'
              : 'bg-amber-600 text-white',
        ]}
      >
        {property.listingType === 'Rent' && property.status === 'Available'
          ? 'For Rent'
          : property.status === 'Available'
            ? 'For Sale'
            : property.status}
      </span>
    </div>

    {/* Featured indicator */}
    {property.featured && (
      <span
        class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-brand-gold text-white px-3 py-0.5 text-[11px] font-bold shadow-sm pointer-events-none"
        aria-label="Featured property"
      >
        ★ Featured
      </span>
    )}
  </a>

  {/* ---- Content area ---- */}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    {/* Price */}
    <p class="font-bold text-2xl mb-1.5 tracking-tight text-ink">
      {displayPrice}
    </p>

    {/* Title */}
    <h3 class="font-bold text-lg leading-snug mb-2 line-clamp-1 group-hover:text-action-blue transition-colors">
      <a
        href={href}
        class="no-underline text-ink hover:text-action-blue transition-colors duration-200 focus-visible:outline-action-blue"
      >
        {property.title}
      </a>
    </h3>

    {/* Location */}
    <p class="flex items-center gap-1.5 text-muted text-sm mb-4">
      <MapPin size={15} class="text-action-blue shrink-0" />
      <span class="truncate">{property.location.locality}, {property.location.city}</span>
    </p>

    {/* Metadata divider */}
    <div class="mt-auto border-t border-stone-200/70 pt-4">
      <div class="flex items-center justify-between text-muted text-xs sm:text-sm font-medium">
        {/* ---- Residential / Flat / Villa metadata ---- */}
        {hasRoomInfo(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Bedrooms">
              <BedDouble size={15} class="text-action-blue" />
              {property.bedrooms} Bed
            </span>
            <span class="inline-flex items-center gap-1.5" title="Bathrooms">
              <Bath size={15} class="text-action-blue" />
              {property.bathrooms} Bath
            </span>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-action-blue" />
              {displayArea}
            </span>
          </>
        )}

        {/* ---- Commercial metadata ---- */}
        {isCommercial(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Commercial type">
              <Building2 size={15} class="text-action-blue" />
              {property.commercialType}
            </span>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-action-blue" />
              {displayArea}
            </span>
          </>
        )}

        {/* ---- Land / Plot metadata ---- */}
        {isLandLike(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-action-blue" />
              {displayArea}
            </span>
            {property.facing && (
              <span class="inline-flex items-center gap-1.5" title="Facing direction">
                <Compass size={15} class="text-action-blue" />
                {property.facing}
              </span>
            )}
          </>
        )}
      </div>
    </div>
  </div>

  {/* ---- View Property link ---- */}
  <a
    href={href}
    class="flex items-center justify-between border-t border-stone-200/80 bg-stone-50 px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-ink no-underline transition-all duration-300 group-hover:text-action-blue group-hover:bg-stone-100/70"
  >
    <span>Explore Listing</span>
    <ArrowRight size={15} class="transform group-hover:translate-x-1.5 transition-transform duration-300 text-action-blue" />
  </a>
</article>
