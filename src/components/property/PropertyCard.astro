---
/**
 * PropertyCard — Reusable property card for listings and featured sections.
 *
 * Renders property-type-appropriate metadata:
 * - Residential / Flat / Villa → bedrooms, bathrooms, area
 * - Commercial → commercial type, area
 * - Land / Plot → area, facing
 *
 * Links to /properties/[slug] (page created in Phase 2B).
 */
import {
  type Property,
  hasRoomInfo,
  isCommercial,
  isLandLike,
} from '@/types/property';
import { formatPrice, formatArea } from '@/lib/format';
import { MapPin, BedDouble, Bath, Maximize, Building2, Compass, ArrowRight } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;

const displayPrice = formatPrice(property.price, property.priceInterval);
const displayArea = formatArea(property.area.value, property.area.unit);
const primaryImage = property.images[0];
const href = `/properties/${property.slug}`;

const isSold = property.status === 'Sold' || property.status === 'Rented';
---

<article
  class="group relative flex flex-col rounded-2xl overflow-hidden glass-card transition-all duration-500 hover:-translate-y-1.5"
  id={`property-card-${property.id}`}
>
  {/* ---- Image area ---- */}
  <a
    href={href}
    class="relative block aspect-[16/10] overflow-hidden"
    aria-label={`View ${property.title}`}
    tabindex="-1"
  >
    {primaryImage ? (
      <img
        src={primaryImage.url}
        alt={primaryImage.alt}
        class:list={[
          'h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-108',
          isSold && 'opacity-70 filter grayscale-[0.3]',
        ]}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div
        class="h-full w-full bg-slate-900 flex items-center justify-center"
        role="img"
        aria-label="No image available"
      >
        <span class="text-slate-400 text-sm font-medium">No Image</span>
      </div>
    )}

    {/* Dark gradient overlay for text readability */}
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-transparent pointer-events-none" aria-hidden="true"></div>

    {/* Top badge strip */}
    <div class="absolute top-3 left-3 right-3 flex items-start justify-between pointer-events-none z-10">
      {/* Property type badge */}
      <span class="inline-flex items-center gap-1 rounded-full bg-gray-950/75 backdrop-blur-md border border-white/10 px-3 py-1 text-xs font-semibold text-slate-200">
        {property.propertyType}
      </span>

      {/* Status badge */}
      <span
        class:list={[
          'inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold backdrop-blur-md border',
          property.status === 'Available'
            ? 'bg-blue-600/80 text-white border-blue-400/40'
            : property.status === 'Sold'
              ? 'bg-rose-600/80 text-white border-rose-400/40'
              : 'bg-amber-600/80 text-white border-amber-400/40',
        ]}
      >
        {property.listingType === 'Rent' && property.status === 'Available'
          ? 'For Rent'
          : property.status === 'Available'
            ? 'For Sale'
            : property.status}
      </span>
    </div>

    {/* Featured indicator */}
    {property.featured && (
      <span
        class="absolute bottom-3 left-3 inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 backdrop-blur-md px-3 py-1 text-[11px] font-bold text-white shadow-md shadow-blue-500/20 pointer-events-none"
        aria-label="Featured property"
      >
        ★ Featured
      </span>
    )}
  </a>

  {/* ---- Content area ---- */}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    {/* Price */}
    <p class="font-extrabold text-2xl mb-1.5 tracking-tight text-gradient-electric">
      {displayPrice}
    </p>

    {/* Title */}
    <h3 class="text-white font-semibold text-lg leading-snug mb-2 line-clamp-1 group-hover:text-blue-300 transition-colors">
      <a
        href={href}
        class="no-underline text-white hover:text-blue-300 transition-colors duration-200 focus-visible:outline-blue-400"
      >
        {property.title}
      </a>
    </h3>

    {/* Location */}
    <p class="flex items-center gap-1.5 text-slate-400 text-sm mb-4">
      <MapPin size={15} class="text-blue-400 shrink-0" />
      <span class="truncate">{property.location.locality}, {property.location.city}</span>
    </p>

    {/* Metadata divider */}
    <div class="mt-auto border-t border-white/10 pt-4">
      <div class="flex items-center gap-4 text-slate-300 text-xs sm:text-sm font-medium">
        {/* ---- Residential / Flat / Villa metadata ---- */}
        {hasRoomInfo(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Bedrooms">
              <BedDouble size={15} class="text-blue-400" />
              {property.bedrooms} Bed
            </span>
            <span class="inline-flex items-center gap-1.5" title="Bathrooms">
              <Bath size={15} class="text-blue-400" />
              {property.bathrooms} Bath
            </span>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-blue-400" />
              {displayArea}
            </span>
          </>
        )}

        {/* ---- Commercial metadata ---- */}
        {isCommercial(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Commercial type">
              <Building2 size={15} class="text-blue-400" />
              {property.commercialType}
            </span>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-blue-400" />
              {displayArea}
            </span>
          </>
        )}

        {/* ---- Land / Plot metadata ---- */}
        {isLandLike(property) && (
          <>
            <span class="inline-flex items-center gap-1.5" title="Area">
              <Maximize size={15} class="text-blue-400" />
              {displayArea}
            </span>
            {property.facing && (
              <span class="inline-flex items-center gap-1.5" title="Facing direction">
                <Compass size={15} class="text-blue-400" />
                {property.facing}
              </span>
            )}
          </>
        )}
      </div>
    </div>
  </div>

  {/* ---- View Property link ---- */}
  <a
    href={href}
    class="flex items-center justify-between border-t border-white/10 px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-300 no-underline transition-all duration-300 hover:text-blue-400 hover:bg-white/[0.03] group-hover:border-blue-500/30"
  >
    <span>Explore Listing</span>
    <ArrowRight size={15} class="transform group-hover:translate-x-1.5 transition-transform duration-300 text-blue-400" />
  </a>
</article>
