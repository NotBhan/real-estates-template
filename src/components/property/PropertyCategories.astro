---
/**
 * PropertyCategories — Reusable category navigation.
 * 
 * Used on the homepage as an architectural asset class section,
 * and on the catalogue page as a filter navigation strip.
 */
import { PROPERTY_TYPES } from '@/types/property';
import { House, Building2, Map, Maximize, Key, Building } from '@lucide/astro';

interface Props {
  variant?: 'homepage' | 'filter';
}

const { variant = 'filter' } = Astro.props;

// Determine active category from URL
const activeCategory = Astro.url.searchParams.get('type');

const categoryIcons: Record<string, any> = {
  Residential: House,
  Commercial: Building2,
  Land: Map,
  Plot: Maximize,
  Flat: Key,
  Villa: Building,
};

function getCategoryUrl(type?: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (type) {
    params.set('type', type);
  } else {
    params.delete('type');
  }
  return `/properties?${params.toString()}`;
}
---

{variant === 'homepage' ? (
  <section class="bg-canvas section-padding relative overflow-hidden z-10 border-b border-stone-200/80" aria-labelledby="categories-heading">
    <div class="container-site relative z-10">
      <div class="text-center mb-14" id="categories-header">
        <div class="eyebrow-label mb-3 justify-center">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
          <span>Discover Asset Classes</span>
        </div>
        <h2 class="heading-section text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4 text-ink" id="categories-heading">
          Explore by <span class="font-normal italic text-stone-500">Category</span>
        </h2>
        <p class="text-muted text-base md:text-lg max-w-2xl mx-auto font-light leading-relaxed">
          Find exactly what you're looking for by browsing our specialized property collections across residential, commercial, and land sectors.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-5" id="categories-grid">
        {PROPERTY_TYPES.map((type) => {
          const Icon = categoryIcons[type];
          return (
            <a
              href={getCategoryUrl(type)}
              class="group flex flex-col items-center justify-center p-6 rounded-2xl bg-white border border-stone-200 text-center no-underline transition-all duration-400 hover:-translate-y-1.5 hover:border-action-blue/40 hover:shadow-editorial"
            >
              {Icon && (
                <div class="w-13 h-13 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center mb-4 group-hover:bg-action-blue group-hover:text-white group-hover:border-action-blue transition-all duration-300">
                  <Icon size={24} class="text-ink group-hover:text-white transition-colors duration-300" />
                </div>
              )}
              <span class="text-ink font-bold text-base group-hover:text-action-blue transition-colors">{type}</span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-action-blue mt-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">Browse →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
) : (
  <div class="w-full border-b border-stone-200 mb-8 overflow-x-auto snap-x hide-scrollbar">
    <div class="flex items-center gap-2.5 pb-3 min-w-max">
      <a
        href={getCategoryUrl()}
        class:list={[
          'px-5 py-2.5 text-sm font-semibold rounded-full transition-all duration-300 no-underline snap-start',
          !activeCategory
            ? 'bg-action-blue text-white shadow-sm'
            : 'bg-white text-ink border border-stone-200 hover:border-action-blue/50 hover:text-action-blue',
        ]}
        aria-current={!activeCategory ? 'page' : undefined}
      >
        All Properties
      </a>
      {PROPERTY_TYPES.map((type) => {
        const isActive = activeCategory === type;
        return (
          <a
            href={getCategoryUrl(type)}
            class:list={[
              'px-5 py-2.5 text-sm font-semibold rounded-full transition-all duration-300 no-underline snap-start',
              isActive
                ? 'bg-action-blue text-white shadow-sm'
                : 'bg-white text-ink border border-stone-200 hover:border-action-blue/50 hover:text-action-blue',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {type}
          </a>
        );
      })}
    </div>
  </div>
)}
