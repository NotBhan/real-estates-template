---
import { config } from '@/lib/config';
import { Phone, MessageCircle, Mail } from '@lucide/astro';

interface Props {
  propertyTitle: string;
  propertySlug: string;
}

const { propertyTitle } = Astro.props;

const whatsappMessage = encodeURIComponent(`Hi, I'm interested in "${propertyTitle}". Could you provide more details?`);
const emailSubject = encodeURIComponent(`Enquiry: ${propertyTitle}`);
const emailBody = encodeURIComponent(`Hello,\n\nI would like to know more about the property "${propertyTitle}".\n\nThank you.`);

const whatsappUrl = config.contactWhatsapp ? `https://wa.me/${config.contactWhatsapp}?text=${whatsappMessage}` : undefined;
const phoneUrl = config.contactPhone ? `tel:${config.contactPhone}` : undefined;
const emailUrl = config.contactEmail ? `mailto:${config.contactEmail}?subject=${emailSubject}&body=${emailBody}` : undefined;
---

<section class="section-padding border-t border-stone-200/80 bg-canvas relative overflow-hidden" aria-labelledby="enquiry-heading" id="property-enquiry">
  <div class="container-site relative z-10">
    <div class="max-w-4xl mx-auto bg-white border border-stone-200 rounded-3xl p-8 md:p-14 text-center shadow-editorial relative overflow-hidden">
      
      <div class="relative z-10">
        <div class="eyebrow-label mb-3 justify-center">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
          <span>Direct Consultation</span>
        </div>
        <h2 class="heading-section text-3xl sm:text-4xl font-bold tracking-tight mb-4 text-ink" id="enquiry-heading">Enquire About This Property</h2>
        <p class="text-muted text-base md:text-lg mb-10 max-w-2xl mx-auto font-light leading-relaxed">
          Contact our team to schedule a private viewing or request comprehensive investment documentation for 
          <span class="text-ink font-bold">"{propertyTitle}"</span>.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4" id="property-enquiry-actions">
          
          {/* Call Button */}
          {phoneUrl ? (
            <a href={phoneUrl} class="btn btn-action-blue w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold">
              <Phone size={18} />
              <span>Call Now</span>
            </a>
          ) : (
            <span class="btn btn-action-blue w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold opacity-60 cursor-not-allowed" title="Contact details pending">
              <Phone size={18} />
              <span>Call Now</span>
            </span>
          )}

          {/* WhatsApp Button */}
          {whatsappUrl ? (
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-stone-outline w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold text-emerald-700 hover:bg-emerald-50 hover:border-emerald-300 transition-all">
              <MessageCircle size={18} />
              <span>WhatsApp</span>
            </a>
          ) : (
            <span class="btn btn-stone-outline w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold text-muted opacity-60 cursor-not-allowed" title="WhatsApp details pending">
              <MessageCircle size={18} />
              <span>WhatsApp</span>
            </span>
          )}

          {/* Email Button */}
          {emailUrl ? (
            <a href={emailUrl} class="btn btn-stone-outline w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold text-ink hover:text-action-blue hover:border-action-blue transition-all">
              <Mail size={18} />
              <span>Email Us</span>
            </a>
          ) : (
            <span class="btn btn-stone-outline w-full sm:w-auto min-w-[170px] py-3.5 rounded-full font-semibold text-muted opacity-60 cursor-not-allowed" title="Email details pending">
              <Mail size={18} />
              <span>Email Us</span>
            </span>
          )}

        </div>

        <p class="text-xs text-muted-light mt-8">
          This is a pre-contract demo action surface.
        </p>
      </div>
    </div>
  </div>
</section>
