---
import { config } from '@/lib/config';
import { Phone, MessageCircle, Mail } from '@lucide/astro';

interface Props {
  propertyTitle: string;
  propertySlug: string;
}

const { propertyTitle } = Astro.props;

// Prepare pre-filled messages
const whatsappMessage = encodeURIComponent(`Hi, I'm interested in "${propertyTitle}". Could you provide more details?`);
const emailSubject = encodeURIComponent(`Enquiry: ${propertyTitle}`);
const emailBody = encodeURIComponent(`Hello,\n\I would like to know more about the property "${propertyTitle}".\n\nThank you.`);

// Construct links
const whatsappUrl = config.contactWhatsapp ? `https://wa.me/${config.contactWhatsapp}?text=${whatsappMessage}` : undefined;
const phoneUrl = config.contactPhone ? `tel:${config.contactPhone}` : undefined;
const emailUrl = config.contactEmail ? `mailto:${config.contactEmail}?subject=${emailSubject}&body=${emailBody}` : undefined;
---

<section class="section-detail border-t border-white/10 bg-bg-primary relative overflow-hidden" aria-labelledby="enquiry-heading" id="property-enquiry">
  <div class="container-site relative z-10">
    <div class="max-w-4xl mx-auto glass-card border border-white/15 rounded-3xl p-8 md:p-14 text-center shadow-2xl shadow-blue-950/80 relative overflow-hidden">
      
      {/* Decorative electric glow in background */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[120%] h-40 bg-blue-600/20 blur-[120px] pointer-events-none"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-surface text-blue-400 border border-blue-500/20 text-xs font-semibold uppercase tracking-[0.15em] mb-4">
          Direct Consultation
        </div>
        <h2 class="text-gradient-silver text-3xl sm:text-4xl font-extrabold tracking-tight mb-6" id="enquiry-heading">Enquire About This Residence</h2>
        <p class="text-slate-300 text-lg mb-10 max-w-2xl mx-auto font-light leading-relaxed">
          Contact our team to schedule a private viewing or request comprehensive investment documentation for 
          <span class="text-white font-semibold">"{propertyTitle}"</span>.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4" id="property-enquiry-actions">
          
          {/* Call Button */}
          {phoneUrl ? (
            <a href={phoneUrl} class="btn btn-electric w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold">
              <Phone size={18} />
              <span>Call Now</span>
            </a>
          ) : (
            <span class="btn btn-electric w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold opacity-60 cursor-not-allowed" title="Contact details pending">
              <Phone size={18} />
              <span>Call Now</span>
            </span>
          )}

          {/* WhatsApp Button */}
          {whatsappUrl ? (
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn glass-surface border border-white/15 w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold text-slate-200 hover:bg-[#25D366]/15 hover:border-[#25D366] hover:text-[#25D366] transition-all">
              <MessageCircle size={18} />
              <span>WhatsApp</span>
            </a>
          ) : (
            <span class="btn glass-surface border border-white/15 w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold text-slate-400 opacity-60 cursor-not-allowed" title="WhatsApp details pending">
              <MessageCircle size={18} />
              <span>WhatsApp</span>
            </span>
          )}

          {/* Email Button */}
          {emailUrl ? (
            <a href={emailUrl} class="btn glass-surface border border-white/15 w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold text-slate-200 hover:text-blue-300 hover:border-blue-500/40 transition-all">
              <Mail size={18} />
              <span>Email Us</span>
            </a>
          ) : (
            <span class="btn glass-surface border border-white/15 w-full sm:w-auto min-w-[170px] py-3.5 rounded-xl font-semibold text-slate-400 opacity-60 cursor-not-allowed" title="Email details pending">
              <Mail size={18} />
              <span>Email Us</span>
            </span>
          )}

        </div>

        <p class="text-xs text-slate-500 mt-8">
          This is a pre-contract demo action surface.
        </p>
      </div>
    </div>
  </div>
</section>
