---
import type { PropertyImage } from '@/types/property';

interface Props {
  images: PropertyImage[];
  propertyTitle: string;
}

const { images, propertyTitle } = Astro.props;

if (!images || images.length <= 1) {
  // Gallery only renders if there are 2 or more images.
  // Single image is handled by PropertyHero.
  return;
}
---

<section class="section-detail border-t border-white/10 bg-bg-primary relative overflow-hidden" aria-labelledby="gallery-heading" id="property-gallery">
  <div class="container-site relative z-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-surface text-blue-400 border border-blue-500/20 text-xs font-semibold uppercase tracking-[0.15em] mb-4">
        Visual Media
      </div>
      <h2 class="text-gradient-silver text-3xl font-extrabold tracking-tight" id="gallery-heading">Property Photographs</h2>
    </div>

    <div class="flex flex-col gap-5 max-w-5xl">
      {/* Primary Image Display */}
      <div class="relative w-full aspect-[4/3] md:aspect-[16/10] overflow-hidden rounded-2xl glass-card border border-white/15 shadow-2xl shadow-blue-950/50" id="property-gallery-primary">
        <img 
          id="gallery-main-img"
          src={images[0].url} 
          alt={images[0].alt || `${propertyTitle} — main image`}
          class="w-full h-full object-cover object-center transition-opacity duration-300 filter brightness-[0.9]"
          loading="lazy"
        />
      </div>

      {/* Thumbnails Strip */}
      <div 
        class="flex items-center gap-3.5 overflow-x-auto snap-x hide-scrollbar pb-2 pt-1" 
        id="property-gallery-thumbs"
        role="group" 
        aria-label="Image gallery thumbnails"
      >
        {images.map((img, index) => (
          <button
            type="button"
            class="gallery-thumb group relative shrink-0 w-24 h-18 md:w-36 md:h-24 rounded-xl overflow-hidden snap-start focus-visible:outline-none border-2 transition-all duration-300"
            class:list={[
              index === 0 ? 'border-blue-500 shadow-lg shadow-blue-500/30 scale-105' : 'border-white/10 hover:border-blue-400/50'
            ]}
            data-src={img.url}
            data-alt={img.alt || `${propertyTitle} — image ${index + 1}`}
            aria-current={index === 0 ? 'true' : 'false'}
            aria-label={`View image ${index + 1}`}
          >
            <img 
              src={img.url} 
              alt=""
              class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            {/* Overlay for inactive state */}
            <div 
              class="thumb-overlay absolute inset-0 bg-gray-950/60 transition-opacity duration-300 pointer-events-none"
              class:list={[index === 0 ? 'opacity-0' : 'opacity-100 group-hover:opacity-20']}
            ></div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function setupGallery() {
    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;
    const thumbs = document.querySelectorAll('.gallery-thumb');

    if (!mainImg || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const newSrc = target.getAttribute('data-src');
        const newAlt = target.getAttribute('data-alt');

        if (newSrc && newAlt) {
          mainImg.src = newSrc;
          mainImg.alt = newAlt;

          thumbs.forEach((t) => {
            t.setAttribute('aria-current', 'false');
            t.classList.remove('border-blue-500', 'shadow-lg', 'shadow-blue-500/30', 'scale-105');
            t.classList.add('border-white/10');
            
            const overlay = t.querySelector('.thumb-overlay');
            if (overlay) {
              overlay.classList.remove('opacity-0');
              overlay.classList.add('opacity-100');
            }
          });

          target.setAttribute('aria-current', 'true');
          target.classList.remove('border-white/10', 'hover:border-blue-400/50');
          target.classList.add('border-blue-500', 'shadow-lg', 'shadow-blue-500/30', 'scale-105');
          
          const targetOverlay = target.querySelector('.thumb-overlay');
          if (targetOverlay) {
            targetOverlay.classList.remove('opacity-100', 'group-hover:opacity-20');
            targetOverlay.classList.add('opacity-0');
          }
        }
      });
    });
  }

  // Setup on initial load and after view transitions (if added later)
  document.addEventListener('astro:page-load', setupGallery);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupGallery();
  } else {
    document.addEventListener('DOMContentLoaded', setupGallery);
  }
</script>
