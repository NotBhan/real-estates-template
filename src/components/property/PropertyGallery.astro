---
import type { PropertyImage } from '@/types/property';

interface Props {
  images: PropertyImage[];
  propertyTitle: string;
}

const { images, propertyTitle } = Astro.props;

if (!images || images.length <= 1) {
  return;
}
---

<section class="section-padding border-t border-stone-200/80 bg-canvas relative overflow-hidden" aria-labelledby="gallery-heading" id="property-gallery">
  <div class="container-site relative z-10">
    <div class="mb-8">
      <div class="eyebrow-label mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
        <span>Visual Media</span>
      </div>
      <h2 class="heading-section text-3xl font-bold tracking-tight text-ink" id="gallery-heading">Property Photographs</h2>
    </div>

    <div class="flex flex-col gap-5 max-w-5xl">
      {/* Primary Image Display */}
      <div class="relative w-full aspect-[4/3] md:aspect-[16/10] overflow-hidden rounded-3xl bg-white border border-stone-200 shadow-sm" id="property-gallery-primary">
        <img 
          id="gallery-main-img"
          src={images[0].url} 
          alt={images[0].alt || `${propertyTitle} — main image`}
          class="w-full h-full object-cover object-center transition-opacity duration-300 filter brightness-[0.95]"
          loading="lazy"
        />
      </div>

      {/* Thumbnails Strip */}
      <div 
        class="flex items-center gap-3.5 overflow-x-auto snap-x hide-scrollbar pb-2 pt-1" 
        id="property-gallery-thumbs"
        role="group" 
        aria-label="Image gallery thumbnails"
      >
        {images.map((img, index) => (
          <button
            type="button"
            class="gallery-thumb group relative shrink-0 w-24 h-18 md:w-36 md:h-24 rounded-2xl overflow-hidden snap-start focus-visible:outline-action-blue border-2 transition-all duration-300 cursor-pointer"
            class:list={[
              index === 0 ? 'border-action-blue shadow-sm scale-102' : 'border-stone-200 hover:border-action-blue/50'
            ]}
            data-src={img.url}
            data-alt={img.alt || `${propertyTitle} — image ${index + 1}`}
            aria-current={index === 0 ? 'true' : 'false'}
            aria-label={`View image ${index + 1}`}
          >
            <img 
              src={img.url} 
              alt=""
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {/* Overlay for inactive state */}
            <div 
              class="thumb-overlay absolute inset-0 bg-stone-900/30 transition-opacity duration-300 pointer-events-none"
              class:list={[index === 0 ? 'opacity-0' : 'opacity-100 group-hover:opacity-10']}
            ></div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function setupGallery() {
    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;
    const thumbs = document.querySelectorAll('.gallery-thumb');

    if (!mainImg || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const newSrc = target.getAttribute('data-src');
        const newAlt = target.getAttribute('data-alt');

        if (newSrc && newAlt) {
          mainImg.src = newSrc;
          mainImg.alt = newAlt;

          thumbs.forEach((t) => {
            t.setAttribute('aria-current', 'false');
            t.classList.remove('border-action-blue', 'shadow-sm', 'scale-102');
            t.classList.add('border-stone-200');
            
            const overlay = t.querySelector('.thumb-overlay');
            if (overlay) {
              overlay.classList.remove('opacity-0');
              overlay.classList.add('opacity-100');
            }
          });

          target.setAttribute('aria-current', 'true');
          target.classList.remove('border-stone-200', 'hover:border-action-blue/50');
          target.classList.add('border-action-blue', 'shadow-sm', 'scale-102');
          
          const targetOverlay = target.querySelector('.thumb-overlay');
          if (targetOverlay) {
            targetOverlay.classList.remove('opacity-100', 'group-hover:opacity-10');
            targetOverlay.classList.add('opacity-0');
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupGallery);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupGallery();
  } else {
    document.addEventListener('DOMContentLoaded', setupGallery);
  }
</script>
