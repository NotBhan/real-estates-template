---
import type { Property } from '@/types/property';
import { Camera } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;
const primaryImage = property.images[0];
const imageCount = property.images.length;

// Ensure alt text is meaningful
const altText = primaryImage?.alt || `${property.title} - Main view`;
---

<div class="relative w-full aspect-[4/3] md:aspect-[16/10] xl:aspect-[21/9] xl:max-h-[75vh] overflow-hidden bg-gray-950" id="property-hero-image">
  {primaryImage ? (
    <img 
      src={primaryImage.url} 
      alt={altText}
      class="w-full h-full object-cover object-center filter brightness-[0.85] contrast-[1.05]"
      fetchpriority="high"
      loading="eager"
    />
  ) : (
    <div class="w-full h-full flex items-center justify-center text-slate-400">
      <span>No image available</span>
    </div>
  )}

  {/* Gradient Overlay for bottom readability */}
  <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-bg-primary/30 to-transparent pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-bg-primary/50 via-transparent to-bg-primary/50 pointer-events-none"></div>

  {/* Badges Container */}
  <div class="absolute top-28 left-4 right-4 md:left-8 md:right-8 flex justify-between items-start pointer-events-none z-10" id="property-hero-badges">
    {/* Property Type */}
    <div class="glass-surface border border-white/15 text-slate-200 text-xs font-semibold uppercase tracking-[0.15em] px-4 py-2 rounded-full pointer-events-auto shadow-lg shadow-black/40">
      {property.propertyType}
    </div>

    {/* Status / Featured */}
    <div class="flex flex-col items-end gap-2 pointer-events-auto">
      {property.status !== 'Available' ? (
        <div class="glass-surface border border-white/15 text-slate-300 text-xs font-semibold uppercase tracking-[0.15em] px-4 py-2 rounded-full shadow-lg shadow-black/40" aria-label={`Status: ${property.status}`}>
          {property.status}
        </div>
      ) : (
        <div class="btn-electric text-white text-xs font-bold uppercase tracking-[0.15em] px-4 py-2 rounded-full shadow-lg shadow-blue-500/30">
          For {property.listingType}
        </div>
      )}
      {property.featured && (
        <div class="bg-gradient-to-r from-blue-600 to-purple-600 border border-white/20 text-white text-xs font-bold uppercase tracking-[0.15em] px-4 py-2 rounded-full shadow-lg shadow-purple-500/20">
          ★ Featured
        </div>
      )}
    </div>
  </div>

  {/* Gallery Entry Button */}
  {imageCount > 1 && (
    <div class="absolute bottom-8 right-6 md:right-10 pointer-events-auto z-10">
      <a 
        href="#property-gallery" 
        class="flex items-center gap-2.5 glass-card border border-white/20 hover:border-blue-400 text-white text-xs font-semibold uppercase tracking-wider px-5 py-3 rounded-xl transition-all duration-300 shadow-2xl shadow-blue-950/80 no-underline hover:scale-105"
      >
        <Camera size={18} class="text-blue-400" />
        <span>View {imageCount} Photographs</span>
      </a>
    </div>
  )}
</div>
