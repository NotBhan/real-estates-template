---
import type { Property } from '@/types/property';
import { hasRoomInfo, isCommercial, isLandLike } from '@/types/property';
import { formatPrice, formatArea } from '@/lib/format';
import { MapPin, BedDouble, Bath, Maximize, Building2, Compass, Car, Layers } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;

const formattedPrice = formatPrice(property.price);
const priceSuffix = property.priceInterval ? `/${property.priceInterval === 'month' ? 'mo' : 'yr'}` : '';

const hasRooms = hasRoomInfo(property);
const isComm = isCommercial(property);
const isLand = isLandLike(property);
const isFlat = property.propertyType === 'Flat';
---

<div class="container-site pt-8 pb-10">
  <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-8">
    
    {/* Title & Location */}
    <div class="flex-1">
      <h1 class="text-ink text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-3" id="property-title">
        {property.title}
      </h1>
      <p class="flex items-center gap-2 text-muted text-base md:text-lg font-light">
        <MapPin size={20} class="text-action-blue shrink-0" />
        <span>{property.location.locality}, {property.location.city}</span>
      </p>
    </div>

    {/* Price */}
    <div class="flex flex-col items-start md:items-end md:shrink-0" id="property-price">
      <p class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight">
        {formattedPrice}<span class="text-xl text-muted font-normal ml-1">{priceSuffix}</span>
      </p>
    </div>
  </div>

  {/* Metadata Strip */}
  <div class="grid grid-cols-2 md:flex md:flex-wrap items-center gap-4 md:gap-6 pt-8 border-t border-stone-200" id="property-metadata">
    
    {/* Shared: Area */}
    <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
      <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
        <Maximize size={20} />
      </div>
      <div>
        <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Area</p>
        <p class="text-ink font-bold text-base">{formatArea(property.area.value, property.area.unit)}</p>
      </div>
    </div>

    {/* Residential / Flat / Villa */}
    {hasRooms && (
      <>
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
          <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
            <BedDouble size={20} />
          </div>
          <div>
            <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Bedrooms</p>
            <p class="text-ink font-bold text-base">{property.bedrooms}</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
          <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
            <Bath size={20} />
          </div>
          <div>
            <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Bathrooms</p>
            <p class="text-ink font-bold text-base">{property.bathrooms}</p>
          </div>
        </div>
      </>
    )}

    {/* Flat specific */}
    {isFlat && 'floor' in property && (
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
        <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
          <Layers size={20} />
        </div>
        <div>
          <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Floor</p>
          <p class="text-ink font-bold text-base">
            {property.floor} {property.totalFloors ? `of ${property.totalFloors}` : ''}
          </p>
        </div>
      </div>
    )}

    {/* Commercial specific */}
    {isComm && 'commercialType' in property && (
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
        <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
          <Building2 size={20} />
        </div>
        <div>
          <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Type</p>
          <p class="text-ink font-bold text-base">{property.commercialType}</p>
        </div>
      </div>
    )}

    {/* Land / Plot specific */}
    {isLand && 'facing' in property && property.facing && (
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
        <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
          <Compass size={20} />
        </div>
        <div>
          <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Facing</p>
          <p class="text-ink font-bold text-base">{property.facing}</p>
        </div>
      </div>
    )}
    
    {isLand && 'roadWidth' in property && property.roadWidth && (
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
        <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
          <MapPin size={20} />
        </div>
        <div>
          <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Road Width</p>
          <p class="text-ink font-bold text-base">{property.roadWidth}</p>
        </div>
      </div>
    )}

    {/* Parking */}
    {'parking' in property && property.parking !== undefined && property.parking > 0 && (
      <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white border border-stone-200 flex-1 min-w-[140px] shadow-xs">
        <div class="p-2.5 bg-stone-100 border border-stone-200 rounded-xl text-action-blue">
          <Car size={20} />
        </div>
        <div>
          <p class="text-[11px] text-muted uppercase tracking-wider font-bold mb-0.5">Parking</p>
          <p class="text-ink font-bold text-base">{property.parking}</p>
        </div>
      </div>
    )}

  </div>
</div>
