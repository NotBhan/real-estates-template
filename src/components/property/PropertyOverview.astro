---
import type { Property } from '@/types/property';
import { Check } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;
const hasAmenities = 'amenities' in property && Array.isArray(property.amenities) && property.amenities.length > 0;
---

<section class="section-detail border-t border-white/10 bg-bg-primary relative overflow-hidden" aria-labelledby="overview-heading" id="property-overview">
  <div class="container-site relative z-10">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-surface text-blue-400 border border-blue-500/20 text-xs font-semibold uppercase tracking-[0.15em] mb-4">
        Property Overview
      </div>
      <h2 class="text-gradient-silver text-3xl font-extrabold tracking-tight mb-6" id="overview-heading">About This Residence</h2>
      
      <div class="prose prose-invert prose-lg max-w-none">
        <p class="text-slate-300 text-lg leading-relaxed font-light whitespace-pre-line">
          {property.description}
        </p>
      </div>

      {hasAmenities && (
        <div class="mt-12 pt-10 border-t border-white/10" id="property-amenities">
          <h3 class="text-xl font-bold text-white mb-6">Features & Amenities</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" role="list">
            {(property as any).amenities.map((amenity: string) => (
              <li class="flex items-center gap-3.5 p-4 rounded-xl glass-card border border-white/10">
                <div class="p-1.5 bg-blue-500/10 border border-blue-500/20 rounded-lg text-blue-400 shrink-0">
                  <Check size={16} class="stroke-[3px]" />
                </div>
                <span class="text-slate-200 font-medium text-sm">{amenity}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>
