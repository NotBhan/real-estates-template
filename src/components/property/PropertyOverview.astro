---
import type { Property } from '@/types/property';
import { Check } from '@lucide/astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;
const hasAmenities = 'amenities' in property && Array.isArray(property.amenities) && property.amenities.length > 0;
---

<section class="section-detail border-t border-border bg-bg-primary" aria-labelledby="overview-heading" id="property-overview">
  <div class="container-site">
    <div class="max-w-3xl">
      <p class="kicker mb-3">Overview</p>
      <h2 class="heading-section mb-6" id="overview-heading">About This Property</h2>
      
      <div class="prose prose-invert prose-lg max-w-none">
        <p class="text-body--light text-lg leading-relaxed whitespace-pre-line">
          {property.description}
        </p>
      </div>

      {hasAmenities && (
        <div class="mt-10 pt-8 border-t border-white/5" id="property-amenities">
          <h3 class="text-xl font-bold text-white mb-6">Amenities & Features</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
            {(property as any).amenities.map((amenity: string) => (
              <li class="flex items-start gap-3">
                <div class="mt-0.5 p-1 bg-accent/10 rounded text-accent shrink-0">
                  <Check size={16} class="stroke-[3px]" />
                </div>
                <span class="text-white">{amenity}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>
