---
import { PROPERTY_TYPES } from '@/types/property';
import { Search } from '@lucide/astro';

interface Props {
  variant?: 'default' | 'hero';
}

const { variant = 'default' } = Astro.props;

const url = Astro.url;
const currentQ = url.searchParams.get('q') || '';
const currentType = url.searchParams.get('type') || '';
const currentListing = url.searchParams.get('listing') || '';
const currentMinPrice = url.searchParams.get('minPrice') || '';
const currentMaxPrice = url.searchParams.get('maxPrice') || '';

const isHero = variant === 'hero';

const formContainerClasses = isHero
  ? 'bg-white border border-stone-200/90 p-5 sm:p-7 md:p-8 rounded-3xl shadow-editorial relative z-20 w-full max-w-5xl mx-auto -mt-16 sm:-mt-20 md:mt-8 lg:mt-10'
  : 'bg-white border border-stone-200 p-5 md:p-6 rounded-2xl w-full shadow-sm';

const gridClasses = isHero
  ? 'grid grid-cols-2 md:grid-cols-2 lg:grid-cols-[3.2fr_1.6fr_1.4fr_1.2fr_1.2fr_1.4fr] gap-3 sm:gap-4 items-end'
  : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4 items-end';
---

<form method="GET" action="/properties" class={formContainerClasses}>
  <div class={gridClasses}>
    {/* Keyword Search */}
    <div class={isHero ? 'col-span-2 md:col-span-2 lg:col-span-1 min-w-0' : 'lg:col-span-2 min-w-0'}>
      <label for={`q-${variant}`} class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
        Location or Keyword
      </label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-muted-light">
          <Search size={18} />
        </div>
        <input
          type="text"
          id={`q-${variant}`}
          name="q"
          value={currentQ}
          placeholder="e.g. Gurugram, Villa, 4BHK..."
          class="w-full bg-stone-50 border border-stone-200 rounded-xl py-3 pl-10 pr-4 text-ink text-sm placeholder:text-muted-light focus:outline-none focus:border-action-blue focus:bg-white transition-all min-h-[44px]"
        />
      </div>
    </div>

    {/* Property Type */}
    <div class={isHero ? 'col-span-2 md:col-span-1 lg:col-span-1 min-w-0' : 'min-w-0'}>
      <label for={`type-${variant}`} class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
        Property Type
      </label>
      <select
        id={`type-${variant}`}
        name="type"
        class="w-full bg-stone-50 border border-stone-200 rounded-xl py-3 px-4 text-ink text-sm focus:outline-none focus:border-action-blue focus:bg-white transition-all min-h-[44px]"
      >
        <option value="" class="bg-white">All Types</option>
        {PROPERTY_TYPES.map((type) => (
          <option value={type} selected={currentType === type} class="bg-white">
            {type}
          </option>
        ))}
      </select>
    </div>

    {/* Listing Type */}
    <div class={isHero ? 'col-span-2 md:col-span-1 lg:col-span-1 min-w-0' : 'min-w-0'}>
      <label for={`listing-${variant}`} class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
        Status
      </label>
      <select
        id={`listing-${variant}`}
        name="listing"
        class="w-full bg-stone-50 border border-stone-200 rounded-xl py-3 px-4 text-ink text-sm focus:outline-none focus:border-action-blue focus:bg-white transition-all min-h-[44px]"
      >
        <option value="" class="bg-white">Any Status</option>
        <option value="Sale" selected={currentListing === 'Sale'} class="bg-white">For Sale</option>
        <option value="Rent" selected={currentListing === 'Rent'} class="bg-white">For Rent</option>
      </select>
    </div>

    {/* Min Price */}
    <div class={isHero ? 'col-span-1 md:col-span-1 lg:col-span-1 min-w-0' : 'min-w-0'}>
      <label for={`minPrice-${variant}`} class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
        Min Price
      </label>
      <input
        type="number"
        id={`minPrice-${variant}`}
        name="minPrice"
        value={currentMinPrice}
        placeholder="₹ Min"
        min="0"
        step="100000"
        class="w-full bg-stone-50 border border-stone-200 rounded-xl py-3 px-3 text-ink text-sm placeholder:text-muted-light focus:outline-none focus:border-action-blue focus:bg-white transition-all min-h-[44px]"
      />
    </div>

    {/* Max Price */}
    <div class={isHero ? 'col-span-1 md:col-span-1 lg:col-span-1 min-w-0' : 'min-w-0'}>
      <label for={`maxPrice-${variant}`} class="block text-xs font-bold uppercase tracking-wider text-muted mb-2">
        Max Price
      </label>
      <input
        type="number"
        id={`maxPrice-${variant}`}
        name="maxPrice"
        value={currentMaxPrice}
        placeholder="₹ Max"
        min="0"
        step="100000"
        class="w-full bg-stone-50 border border-stone-200 rounded-xl py-3 px-3 text-ink text-sm placeholder:text-muted-light focus:outline-none focus:border-action-blue focus:bg-white transition-all min-h-[44px]"
      />
    </div>

    {/* Submit Button */}
    <div class={isHero ? 'col-span-2 md:col-span-2 lg:col-span-1 min-w-0 h-full flex items-end pt-2 lg:pt-0' : 'lg:col-span-1 min-w-0 h-full flex items-end pt-2 lg:pt-0'}>
      <button type="submit" class="btn btn-action-blue w-full min-h-[44px] rounded-xl flex items-center justify-center font-semibold text-sm tracking-wide">
        Search
      </button>
    </div>
  </div>
</form>

