---
import PropertyCard from '@components/property/PropertyCard.astro';
import { getFeaturedProperties } from '@/data/demo-properties';
import { ArrowRight, Sparkles } from '@lucide/astro';

const featured = getFeaturedProperties();
---

<section
  class="bg-white section-padding relative overflow-hidden z-10 border-b border-stone-200/80"
  aria-labelledby="featured-heading"
  id="featured-properties"
>
  <div class="container-site relative z-10">
    {/* ---- Section header ---- */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6" id="featured-header">
      <div>
        <div class="eyebrow-label mb-3">
          <Sparkles size={13} class="text-brand-gold" />
          <span>Curated Portfolio</span>
        </div>
        <h2
          class="heading-section text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink"
          id="featured-heading"
        >
          Architectural <span class="font-normal italic text-stone-500">Highlights</span>
        </h2>
      </div>

      <p class="text-muted text-base md:text-lg max-w-md leading-relaxed font-light">
        A handpicked collection of premier residences, commercial hubs, and strategic land investments across Delhi NCR.
      </p>
    </div>

    {/* ---- Property grid with GSAP staggered entrance ---- */}
    {featured.length > 0 ? (
      <div id="featured-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
        {featured.map((property) => (
          <div class="featured-card-wrapper h-full flex flex-col">
            <PropertyCard property={property} />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-muted py-16">
        No featured properties at this time.
      </p>
    )}

    {/* ---- CTA ---- */}
    <div class="text-center mt-14">
      <a
        href="/properties"
        class="btn btn-action-blue text-base px-8 py-3.5 rounded-full inline-flex items-center gap-3 shadow-md"
      >
        <span>Explore Entire Collection</span>
        <ArrowRight size={18} />
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initFeaturedSection = () => {
    const grid = document.getElementById('featured-grid');
    const cards = document.querySelectorAll('.featured-card-wrapper');
    const header = document.getElementById('featured-header');

    if (!grid || cards.length === 0) return;

    let mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // Header reveal
      if (header) {
        gsap.from(header, {
          scrollTrigger: {
            trigger: header,
            start: 'top 85%',
          },
          opacity: 0,
          y: 35,
          duration: 0.8,
          ease: 'power3.out',
        });
      }

      // Staggered cards reveal
      gsap.from(cards, {
        scrollTrigger: {
          trigger: grid,
          start: 'top 82%',
        },
        opacity: 0,
        y: 45,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power3.out',
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeaturedSection);
  } else {
    initFeaturedSection();
  }
  document.addEventListener('astro:page-load', initFeaturedSection);
</script>
