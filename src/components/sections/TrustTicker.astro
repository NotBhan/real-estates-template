---
import { Building, ShieldCheck, MapPin, Layers, Award, Sparkles } from '@lucide/astro';

const tickerItems = [
  { icon: ShieldCheck, text: 'Verified Property Listings' },
  { icon: MapPin, text: 'Prime Locations in Gurugram & Delhi NCR' },
  { icon: Building, text: 'Residential Apartments & Luxury Villas' },
  { icon: Layers, text: 'Commercial Space & Office Hubs' },
  { icon: Award, text: 'Trusted Real Estate Consultancy' },
  { icon: Sparkles, text: 'Tailored Investment Strategy' },
];
---

<section class="py-6 bg-gradient-to-r from-blue-950/40 via-purple-950/20 to-blue-950/40 border-y border-white/10 overflow-hidden relative z-20" aria-label="Trust Signals">
  <div class="animate-marquee flex items-center gap-12 whitespace-nowrap">
    {/* First copy */}
    {tickerItems.map((item) => {
      const Icon = item.icon;
      return (
        <div class="flex items-center gap-3 text-slate-300 text-sm font-medium tracking-wider uppercase">
          <span class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
            <Icon size={16} />
          </span>
          <span>{item.text}</span>
          <span class="text-blue-500/40 font-bold ml-6">•</span>
        </div>
      );
    })}

    {/* Duplicate copy for infinite loop */}
    {tickerItems.map((item) => {
      const Icon = item.icon;
      return (
        <div class="flex items-center gap-3 text-slate-300 text-sm font-medium tracking-wider uppercase">
          <span class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
            <Icon size={16} />
          </span>
          <span>{item.text}</span>
          <span class="text-blue-500/40 font-bold ml-6">•</span>
        </div>
      );
    })}
  </div>
</section>
