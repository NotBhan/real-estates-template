---
import { Building, ShieldCheck, MapPin, Layers, Award, Sparkles } from '@lucide/astro';

const tickerItems = [
  { icon: ShieldCheck, text: 'Verified Property Listings' },
  { icon: MapPin, text: 'Prime Locations in Gurugram & Delhi NCR' },
  { icon: Building, text: 'Residential Apartments & Luxury Villas' },
  { icon: Layers, text: 'Commercial Space & Office Hubs' },
  { icon: Award, text: 'Trusted Real Estate Consultancy' },
  { icon: Sparkles, text: 'Tailored Investment Strategy' },
];
---

<section class="py-5 bg-surface-stone border-y border-stone-300/70 overflow-hidden relative z-20" aria-label="Trust Signals">
  <div class="animate-marquee flex items-center gap-12 whitespace-nowrap">
    {/* First copy */}
    {tickerItems.map((item) => {
      const Icon = item.icon;
      return (
        <div class="flex items-center gap-3 text-ink text-xs font-semibold tracking-widest uppercase">
          <span class="w-7 h-7 rounded-full bg-white border border-stone-300 flex items-center justify-center text-action-blue shrink-0 shadow-xs">
            <Icon size={14} />
          </span>
          <span>{item.text}</span>
          <span class="text-brand-gold font-bold ml-6">•</span>
        </div>
      );
    })}

    {/* Duplicate copy for infinite loop */}
    {tickerItems.map((item) => {
      const Icon = item.icon;
      return (
        <div class="flex items-center gap-3 text-ink text-xs font-semibold tracking-widest uppercase">
          <span class="w-7 h-7 rounded-full bg-white border border-stone-300 flex items-center justify-center text-action-blue shrink-0 shadow-xs">
            <Icon size={14} />
          </span>
          <span>{item.text}</span>
          <span class="text-brand-gold font-bold ml-6">•</span>
        </div>
      );
    })}
  </div>
</section>
