---
import '@/styles/global.css';
import { config } from '@/lib/config';
import {
  LayoutDashboard,
  Building2,
  PlusCircle,
  Settings,
  ExternalLink,
  LogOut,
  ShieldCheck,
  Menu,
  X,
} from '@lucide/astro';

interface Props {
  title: string;
  activeNav?: 'dashboard' | 'properties' | 'new-property' | 'settings';
}

const { title, activeNav = 'dashboard' } = Astro.props;
const pageTitle = `${title} — CMS Admin | ${config.brand.name}`;
---

<!doctype html>
<html lang="en" class="h-full bg-canvas">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="h-full font-sans text-ink bg-canvas antialiased flex flex-col">
    {/* Admin Header / Top Bar */}
    <header class="bg-surface-dark text-white border-b border-stone-800 sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        {/* Brand */}
        <div class="flex items-center gap-3">
          <a href="/admin" class="flex items-center gap-2.5 text-white font-bold text-lg tracking-tight no-underline group">
            <span class="w-8 h-8 rounded-xl bg-brand-gold text-stone-950 flex items-center justify-center font-extrabold text-sm shadow-xs group-hover:scale-105 transition-transform">
              {config.brandInitials}
            </span>
            <span class="font-bold">{config.brand.name} <span class="text-brand-gold text-xs font-normal uppercase tracking-wider ml-1">CMS</span></span>
          </a>
        </div>

        {/* Desktop Admin Quick Actions */}
        <div class="hidden md:flex items-center gap-4">
          <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-stone-300 hover:text-white flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-stone-800 hover:border-stone-700 bg-stone-900/50 hover:bg-stone-900 transition-all"
          >
            <ExternalLink size={14} class="text-brand-gold" />
            <span>View Public Site</span>
          </a>

          <div class="flex items-center gap-2 pl-3 border-l border-stone-800 text-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-stone-300 font-medium">Admin Session</span>
          </div>

          <form action="/admin/login" method="GET" class="m-0">
            <input type="hidden" name="logout" value="1" />
            <button
              type="submit"
              class="text-xs font-semibold text-rose-400 hover:text-rose-300 flex items-center gap-1.5 px-3.5 py-2 rounded-xl hover:bg-rose-950/40 border border-transparent hover:border-rose-900/50 transition-all cursor-pointer"
            >
              <LogOut size={14} />
              <span>Logout</span>
            </button>
          </form>
        </div>

        {/* Mobile Menu Toggle Button */}
        <button
          id="admin-mobile-toggle"
          class="md:hidden text-stone-300 hover:text-white p-2 rounded-xl bg-stone-900 border border-stone-800 active:scale-95 transition-all"
          aria-label="Toggle Navigation Menu"
        >
          <Menu size={20} />
        </button>
      </div>

      {/* Mobile Navigation Dropdown */}
      <div id="admin-mobile-menu" class="hidden md:hidden border-t border-stone-800 bg-stone-900 px-4 py-4 space-y-2">
        <a
          href="/admin"
          class={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
            activeNav === 'dashboard' ? 'bg-action-blue text-white' : 'text-stone-300 hover:bg-stone-800'
          }`}
        >
          <LayoutDashboard size={18} />
          <span>Dashboard</span>
        </a>

        <a
          href="/admin/properties"
          class={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
            activeNav === 'properties' ? 'bg-action-blue text-white' : 'text-stone-300 hover:bg-stone-800'
          }`}
        >
          <Building2 size={18} />
          <span>Property Catalogue</span>
        </a>

        <a
          href="/admin/properties/new"
          class={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
            activeNav === 'new-property' ? 'bg-action-blue text-white' : 'text-stone-300 hover:bg-stone-800'
          }`}
        >
          <PlusCircle size={18} />
          <span>Add New Property</span>
        </a>

        <a
          href="/admin/settings"
          class={`flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
            activeNav === 'settings' ? 'bg-action-blue text-white' : 'text-stone-300 hover:bg-stone-800'
          }`}
        >
          <Settings size={18} />
          <span>Site Content & Settings</span>
        </a>

        <div class="pt-3 border-t border-stone-800 flex items-center justify-between">
          <a
            href="/"
            target="_blank"
            class="text-xs text-stone-300 flex items-center gap-1.5"
          >
            <ExternalLink size={14} class="text-brand-gold" />
            <span>Public Site</span>
          </a>

          <a href="/admin/login?logout=1" class="text-xs text-rose-400 flex items-center gap-1.5">
            <LogOut size={14} />
            <span>Logout</span>
          </a>
        </div>
      </div>
    </header>

    <div class="flex-1 flex max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 gap-8">
      {/* Sidebar Navigation */}
      <aside class="w-64 shrink-0 hidden md:block">
        <div class="bg-white border border-stone-200/80 rounded-2xl p-4 shadow-sm sticky top-24 space-y-1">
          <p class="text-[10px] font-bold uppercase tracking-wider text-muted px-3 mb-2">Management</p>

          <a
            href="/admin"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
              activeNav === 'dashboard'
                ? 'bg-action-blue text-white shadow-xs'
                : 'text-stone-700 hover:bg-stone-100 hover:text-ink'
            }`}
          >
            <LayoutDashboard size={18} />
            <span>Dashboard</span>
          </a>

          <a
            href="/admin/properties"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
              activeNav === 'properties'
                ? 'bg-action-blue text-white shadow-xs'
                : 'text-stone-700 hover:bg-stone-100 hover:text-ink'
            }`}
          >
            <Building2 size={18} />
            <span>Property Catalogue</span>
          </a>

          <a
            href="/admin/properties/new"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
              activeNav === 'new-property'
                ? 'bg-action-blue text-white shadow-xs'
                : 'text-stone-700 hover:bg-stone-100 hover:text-ink'
            }`}
          >
            <PlusCircle size={18} />
            <span>Add New Property</span>
          </a>

          <a
            href="/admin/settings"
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
              activeNav === 'settings'
                ? 'bg-action-blue text-white shadow-xs'
                : 'text-stone-700 hover:bg-stone-100 hover:text-ink'
            }`}
          >
            <Settings size={18} />
            <span>Site Content & Settings</span>
          </a>

          <div class="pt-4 border-t border-stone-100 mt-4">
            <p class="text-[10px] font-bold uppercase tracking-wider text-muted px-3 mb-2">Public Links</p>
            <a
              href="/"
              target="_blank"
              class="flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-medium text-muted hover:text-ink hover:bg-stone-100 transition-colors"
            >
              <ExternalLink size={14} />
              <span>Public Homepage</span>
            </a>
            <a
              href="/properties"
              target="_blank"
              class="flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-medium text-muted hover:text-ink hover:bg-stone-100 transition-colors"
            >
              <ExternalLink size={14} />
              <span>Public Listings</span>
            </a>
          </div>
        </div>
      </aside>

      {/* Main Content View */}
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    </div>

    <script>
      const toggle = document.getElementById('admin-mobile-toggle');
      const menu = document.getElementById('admin-mobile-menu');

      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
