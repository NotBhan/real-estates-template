---
import '@/styles/global.css';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import PropertyAssistant from '@components/assistant/PropertyAssistant.astro';
import { config } from '@/lib/config';

interface Props {
  title: string;
  description?: string;
  /** Optional OG image URL */
  ogImage?: string;
}

const {
  title,
  description = `${config.siteName} — ${config.tagline} ${config.siteDescription}`,
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, config.siteUrl).href;
const fullTitle = title === 'Home'
  ? `${config.siteName} — ${config.tagline}`
  : title.includes(config.siteName)
    ? title
    : `${title} | ${config.siteName}`;

const isPublicPage = !Astro.url.pathname.startsWith('/admin');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.brand.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Favicon -->
    <link rel="icon" href={config.brand.faviconUrl || '/favicon.svg'} />

    <!-- Fonts: Outfit & Inter from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-ink font-sans antialiased overflow-x-hidden w-full min-h-screen">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    {isPublicPage && <PropertyAssistant />}
  </body>
</html>
