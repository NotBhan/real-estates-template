---
import BaseLayout from '@layouts/BaseLayout.astro';
import { config } from '@/lib/config';
---

<BaseLayout title="About" description="Learn about Maa Laxmi Property Consultant.">
  <div class="pt-28 sm:pt-32 pb-12 sm:pb-16 bg-canvas border-b border-stone-200/80">
    <div class="container-site">
      <div class="eyebrow-label mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
        <span>About Us</span>
      </div>
      <h1 class="heading-editorial text-4xl sm:text-5xl md:text-6xl tracking-tight mb-4 text-ink">
        About {config.brand.name}
      </h1>
      <p class="text-muted text-base md:text-lg max-w-2xl font-light">
        Dedicated property advisors for high-value residential, commercial, and land investments across Delhi NCR.
      </p>
    </div>
  </div>
  <div class="bg-canvas section-padding">
    <div class="container-site">
      <div class="bg-white border border-stone-200 rounded-3xl p-8 sm:p-12 max-w-3xl shadow-sm">
        <p class="text-muted text-lg leading-relaxed font-light mb-6">
          Company background and history will be populated with actual client content once supplied.
        </p>
        <p class="text-muted text-base leading-relaxed font-light">
          This demonstration platform exhibits the property catalogue, search discovery engine, and enquiry flow for Maa Laxmi Property Consultant.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
