---
import AdminLayout from '@layouts/AdminLayout.astro';
import { isAuthenticated } from '@/lib/auth';
import { getAdminDashboardStats, getAllStoreProperties } from '@/lib/admin-store';
import { formatPrice } from '@/lib/format';
import {
  Building2,
  Sparkles,
  CheckCircle2,
  Tag,
  PlusCircle,
  ArrowRight,
  ExternalLink,
  Edit3,
} from '@lucide/astro';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const stats = getAdminDashboardStats();
const properties = getAllStoreProperties();
const recentProperties = properties.slice(0, 5);
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  <div class="space-y-8">
    
    {/* Page Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-200/80 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">Dashboard Overview</h1>
        <p class="text-muted text-xs sm:text-sm font-light mt-1">
          CMS overview of properties and active catalogue listings.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/properties/new" class="btn btn-action-blue text-xs py-2.5 px-4 rounded-xl">
          <PlusCircle size={16} />
          <span>Add New Property</span>
        </a>
      </div>
    </div>

    {/* Metrics Cards Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      {/* Total Properties */}
      <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs uppercase font-bold text-muted tracking-wider">Total Listings</span>
          <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-action-blue">
            <Building2 size={18} />
          </div>
        </div>
        <p class="text-3xl font-extrabold text-ink tracking-tight">{stats.totalProperties}</p>
        <p class="text-[11px] text-muted font-light mt-2">Active database count</p>
      </div>

      {/* Featured Properties */}
      <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs uppercase font-bold text-muted tracking-wider">Featured Showcase</span>
          <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
            <Sparkles size={18} />
          </div>
        </div>
        <p class="text-3xl font-extrabold text-ink tracking-tight">{stats.featuredCount}</p>
        <p class="text-[11px] text-muted font-light mt-2">Highlighted on Homepage</p>
      </div>

      {/* Available Properties */}
      <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs uppercase font-bold text-muted tracking-wider">Available Status</span>
          <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600">
            <CheckCircle2 size={18} />
          </div>
        </div>
        <p class="text-3xl font-extrabold text-ink tracking-tight">{stats.availableCount}</p>
        <p class="text-[11px] text-muted font-light mt-2">Ready for acquisition</p>
      </div>

      {/* Sold / Rented */}
      <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs uppercase font-bold text-muted tracking-wider">Closed Deals</span>
          <div class="w-9 h-9 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-600">
            <Tag size={18} />
          </div>
        </div>
        <p class="text-3xl font-extrabold text-ink tracking-tight">{stats.soldCount + stats.rentedCount}</p>
        <p class="text-[11px] text-muted font-light mt-2">Sold ({stats.soldCount}) / Rented ({stats.rentedCount})</p>
      </div>

    </div>

    {/* Recent Properties Table View */}
    <div class="bg-white border border-stone-200/80 rounded-2xl p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-ink">Recent Property Listings</h2>
          <p class="text-xs text-muted font-light">Latest properties managed in CMS</p>
        </div>
        <a href="/admin/properties" class="text-xs font-semibold text-action-blue hover:text-action-blue-hover flex items-center gap-1">
          <span>View All ({stats.totalProperties})</span>
          <ArrowRight size={14} />
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-ink">
          <thead class="bg-canvas border-y border-stone-200 text-[11px] uppercase tracking-wider text-muted font-bold">
            <tr>
              <th class="py-3 px-4">Property Title</th>
              <th class="py-3 px-4">Type</th>
              <th class="py-3 px-4">Listing</th>
              <th class="py-3 px-4">Price</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {recentProperties.map((p) => (
              <tr class="hover:bg-stone-50/80 transition-colors">
                <td class="py-3.5 px-4 font-semibold text-ink">
                  <div class="flex items-center gap-3">
                    <img
                      src={p.images[0]?.url || 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=300&q=80'}
                      alt=""
                      class="w-10 h-10 rounded-lg object-cover border border-stone-200 shrink-0"
                    />
                    <div class="min-w-0">
                      <p class="font-bold text-ink truncate">{p.title}</p>
                      <p class="text-[11px] text-muted font-light truncate">{p.location.locality}, {p.location.city}</p>
                    </div>
                  </div>
                </td>
                <td class="py-3.5 px-4 font-medium">{p.propertyType}</td>
                <td class="py-3.5 px-4">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                    p.listingType === 'Sale' ? 'bg-blue-50 text-blue-700' : 'bg-purple-50 text-purple-700'
                  }`}>
                    For {p.listingType}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-bold text-ink">{formatPrice(p.price)}</td>
                <td class="py-3.5 px-4">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                    p.status === 'Available' ? 'bg-emerald-50 text-emerald-700' : 'bg-stone-100 text-stone-600'
                  }`}>
                    {p.status}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/properties/${p.slug}`}
                      target="_blank"
                      class="p-1.5 rounded-lg text-muted hover:text-ink hover:bg-stone-100"
                      title="View public page"
                    >
                      <ExternalLink size={15} />
                    </a>
                    <a
                      href={`/admin/properties/${p.id}/edit`}
                      class="btn btn-stone-outline px-3 py-1 text-xs rounded-lg font-semibold"
                    >
                      <Edit3 size={13} />
                      <span>Edit</span>
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
