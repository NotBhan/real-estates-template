---
import AdminLayout from '@layouts/AdminLayout.astro';
import { isAuthenticated } from '@/lib/auth';
import { addStoreProperty } from '@/lib/admin-store';
import { saveUploadedImage } from '@/lib/upload';
import type { Property, PropertyType, ListingType, PropertyStatus } from '@/types/property';
import { ArrowLeft, Save, Upload, Link, AlertCircle, MapPin } from '@lucide/astro';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get('title')?.toString().trim() || '';
    const description = formData.get('description')?.toString().trim() || '';
    const propertyType = (formData.get('propertyType')?.toString() || 'Residential') as PropertyType;
    const listingType = (formData.get('listingType')?.toString() || 'Sale') as ListingType;
    const status = (formData.get('status')?.toString() || 'Available') as PropertyStatus;
    const price = Number(formData.get('price')) || 0;

    const address = formData.get('address')?.toString().trim() || '';
    const locality = formData.get('locality')?.toString().trim() || '';
    const city = formData.get('city')?.toString().trim() || 'Metropolitan Area';
    const latitude = formData.get('latitude') ? Number(formData.get('latitude')) : 28.628;
    const longitude = formData.get('longitude') ? Number(formData.get('longitude')) : 77.3649;

    const areaValue = Number(formData.get('areaValue')) || 1000;
    const areaUnit = formData.get('areaUnit')?.toString() || 'sq ft';

    const bedrooms = Number(formData.get('bedrooms')) || 0;
    const bathrooms = Number(formData.get('bathrooms')) || 0;
    const parking = Number(formData.get('parking')) || 0;

    const featured = formData.get('featured') === 'on';
    const reraId = formData.get('reraId')?.toString().trim() || undefined;
    const reraRegistrationUrl = formData.get('reraRegistrationUrl')?.toString().trim() || undefined;

    // Handle Image: Local upload file OR External URL string
    let finalImageUrl = 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1600&q=80';
    const imageFile = formData.get('imageFile') as File | null;
    const externalUrl = formData.get('imageUrl')?.toString().trim();

    if (imageFile && imageFile.size > 0) {
      const uploadedUrl = await saveUploadedImage(imageFile);
      if (uploadedUrl) {
        finalImageUrl = uploadedUrl;
      }
    } else if (externalUrl) {
      finalImageUrl = externalUrl;
    }

    if (!title || price <= 0) {
      errorMessage = 'Please provide a valid property title and price.';
    } else {
      const slug = title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');

      const id = `prop-${Date.now()}`;
      const now = new Date().toISOString();

      const newProperty: Property = {
        id,
        title,
        slug,
        description: description || `${title} located in ${locality}, ${city}.`,
        propertyType,
        listingType,
        status,
        price,
        currency: 'INR',
        location: {
          address: address || locality,
          locality: locality || 'Central',
          city,
          latitude,
          longitude,
        },
        area: {
          value: areaValue,
          unit: areaUnit,
        },
        featured,
        reraId,
        reraRegistrationUrl,
        images: [
          {
            url: finalImageUrl,
            alt: `${title} main photograph`,
            order: 1,
          },
        ],
        bedrooms,
        bathrooms,
        parking,
        createdAt: now,
        updatedAt: now,
      } as any;

      const created = addStoreProperty(newProperty);
      return Astro.redirect(`/properties/${created.slug}`);
    }
  } catch (err) {
    console.error('Error creating property:', err);
    errorMessage = 'Failed to save property. Please check input parameters.';
  }
}
---

<AdminLayout title="Add New Property" activeNav="new-property">
  <div class="max-w-4xl mx-auto space-y-6">
    
    {/* Page Header */}
    <div class="flex items-center justify-between border-b border-stone-200/80 pb-4">
      <div class="flex items-center gap-3">
        <a href="/admin/properties" class="p-2 rounded-xl text-muted hover:text-ink hover:bg-white border border-stone-200 shadow-2xs">
          <ArrowLeft size={18} />
        </a>
        <div>
          <h1 class="text-2xl font-extrabold text-ink tracking-tight">Add New Property</h1>
          <p class="text-muted text-xs font-light">Create a new listing in CMS catalogue</p>
        </div>
      </div>
    </div>

    {/* Error Banner */}
    {errorMessage && (
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium flex items-center gap-2">
        <AlertCircle size={16} class="text-rose-600 shrink-0" />
        <span>{errorMessage}</span>
      </div>
    )}

    {/* Form */}
    <form method="POST" enctype="multipart/form-data" class="bg-white border border-stone-200/80 rounded-3xl p-6 sm:p-8 shadow-editorial space-y-8">
      
      {/* 1. Basic Details */}
      <div class="space-y-4">
        <h2 class="text-base font-bold text-ink border-b border-stone-100 pb-2">1. Basic Information</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="sm:col-span-2">
            <label for="title" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Property Title <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="e.g. Royal Palm Luxury Villa"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="propertyType" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Property Category <span class="text-rose-500">*</span>
            </label>
            <select
              id="propertyType"
              name="propertyType"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            >
              <option value="Residential">Residential</option>
              <option value="Commercial">Commercial</option>
              <option value="Land">Land</option>
              <option value="Plot">Plot</option>
              <option value="Flat">Flat</option>
              <option value="Villa">Villa</option>
            </select>
          </div>

          <div>
            <label for="listingType" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Listing Type <span class="text-rose-500">*</span>
            </label>
            <select
              id="listingType"
              name="listingType"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            >
              <option value="Sale">For Sale</option>
              <option value="Rent">For Rent</option>
            </select>
          </div>

          <div>
            <label for="price" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Price (INR) <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              id="price"
              name="price"
              required
              placeholder="e.g. 7500000"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="status" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Listing Status
            </label>
            <select
              id="status"
              name="status"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            >
              <option value="Available">Available</option>
              <option value="Sold">Sold</option>
              <option value="Rented">Rented</option>
            </select>
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
            Property Description
          </label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Detailed description of features, highlights, and specifications..."
            class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none resize-y"
          ></textarea>
        </div>
      </div>

      {/* 2. Image Selection: Local Upload OR External URL */}
      <div class="space-y-4">
        <h2 class="text-base font-bold text-ink border-b border-stone-100 pb-2">2. Property Photograph</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 bg-canvas p-5 rounded-2xl border border-stone-200/80">
          
          {/* Local File Upload */}
          <div class="space-y-2">
            <label for="imageFile" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <Upload size={14} class="text-action-blue" />
              <span>Upload from Local Storage</span>
            </label>
            <input
              type="file"
              id="imageFile"
              name="imageFile"
              accept="image/png, image/jpeg, image/webp, image/gif"
              class="w-full text-xs text-stone-600 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-action-blue file:text-white hover:file:bg-action-blue-hover cursor-pointer"
            />
            <p class="text-[11px] text-muted font-light">Select `.jpg`, `.png`, or `.webp` file from your device.</p>
          </div>

          {/* External URL */}
          <div class="space-y-2">
            <label for="imageUrl" class="block text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
              <Link size={14} class="text-brand-gold" />
              <span>Or External Image URL</span>
            </label>
            <input
              type="url"
              id="imageUrl"
              name="imageUrl"
              placeholder="https://images.unsplash.com/..."
              class="w-full px-4 py-2.5 rounded-xl bg-white border border-stone-200 text-ink text-xs focus:border-action-blue focus:outline-none"
            />
            <p class="text-[11px] text-muted font-light">Paste a direct image URL if not uploading locally.</p>
          </div>

        </div>
      </div>

      {/* 3. Location & Specs */}
      <div class="space-y-4">
        <h2 class="text-base font-bold text-ink border-b border-stone-100 pb-2">3. Location & Specifications</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label for="locality" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Locality / Sector
            </label>
            <input
              type="text"
              id="locality"
              name="locality"
              placeholder="e.g. Sector 62"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="city" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              City / Region
            </label>
            <input
              type="text"
              id="city"
              name="city"
              value="Central Metropolitan Area"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="address" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Full Address
            </label>
            <input
              type="text"
              id="address"
              name="address"
              placeholder="Plot No 14, Main Road"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>
        </div>

        {/* Map Coordinates & Interactive Picker */}
        <div class="bg-canvas p-5 rounded-2xl border border-stone-200/80 space-y-4">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold text-ink flex items-center gap-1.5">
              <MapPin size={15} class="text-rose-500" />
              <span>Map GPS Location Coordinates</span>
            </p>
            <span class="text-[11px] text-muted font-medium">Click on map or drag pin to set location</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="latitude" class="block text-[11px] font-semibold text-muted mb-1">Latitude</label>
              <input
                type="number"
                step="any"
                id="latitude"
                name="latitude"
                value="28.628"
                placeholder="e.g. 28.628"
                class="w-full px-3 py-2 rounded-xl bg-white border border-stone-200 text-xs text-ink focus:border-action-blue focus:outline-none"
              />
            </div>
            <div>
              <label for="longitude" class="block text-[11px] font-semibold text-muted mb-1">Longitude</label>
              <input
                type="number"
                step="any"
                id="longitude"
                name="longitude"
                value="77.3649"
                placeholder="e.g. 77.3649"
                class="w-full px-3 py-2 rounded-xl bg-white border border-stone-200 text-xs text-ink focus:border-action-blue focus:outline-none"
              />
            </div>
          </div>

          {/* Leaflet OSM Map Container */}
          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
          <div id="admin-map-picker" class="h-60 w-full rounded-xl border border-stone-200/80 overflow-hidden relative z-0"></div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
          <div>
            <label for="areaValue" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Area Value
            </label>
            <input
              type="number"
              id="areaValue"
              name="areaValue"
              placeholder="1800"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="areaUnit" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Area Unit
            </label>
            <select
              id="areaUnit"
              name="areaUnit"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            >
              <option value="sq ft">sq ft</option>
              <option value="sq yd">sq yd</option>
              <option value="acres">acres</option>
            </select>
          </div>

          <div>
            <label for="bedrooms" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Bedrooms
            </label>
            <input
              type="number"
              id="bedrooms"
              name="bedrooms"
              value="3"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="bathrooms" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              Bathrooms
            </label>
            <input
              type="number"
              id="bathrooms"
              name="bathrooms"
              value="3"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>
        </div>
      </div>

      {/* 4. Regulatory & RERA Registration (Optional) */}
      <div class="space-y-4">
        <h2 class="text-base font-bold text-ink border-b border-stone-100 pb-2">4. Regulatory & RERA Disclosures (Optional)</h2>
        <p class="text-xs text-muted font-light">
          Specify state RERA registration details if applicable. If left blank, the listing will display the standard statutory verification advisory.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="reraId" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              RERA Registration Number
            </label>
            <input
              type="text"
              id="reraId"
              name="reraId"
              placeholder="e.g. UPRERAPRJ12345 or HARERA/GGM/..."
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>

          <div>
            <label for="reraRegistrationUrl" class="block text-xs font-bold uppercase tracking-wider text-ink mb-2">
              State RERA Portal Verification URL
            </label>
            <input
              type="url"
              id="reraRegistrationUrl"
              name="reraRegistrationUrl"
              placeholder="e.g. https://up-rera.in/projects"
              class="w-full px-4 py-3 rounded-xl bg-canvas border border-stone-200 text-ink text-sm focus:bg-white focus:border-action-blue focus:outline-none"
            />
          </div>
        </div>
      </div>

      {/* 5. Display Flags */}
      <div class="pt-2 border-t border-stone-100 flex items-center justify-between">
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="featured"
            class="w-5 h-5 accent-action-blue rounded cursor-pointer"
          />
          <div>
            <p class="text-xs font-bold text-ink">Mark as Featured Property</p>
            <p class="text-[11px] text-muted font-light">Showcase this property on the homepage featured section</p>
          </div>
        </label>
      </div>

      {/* Form Submit Actions */}
      <div class="pt-4 border-t border-stone-200 flex items-center justify-end gap-4">
        <a href="/admin/properties" class="btn btn-stone-outline text-xs px-5 py-3 rounded-xl">
          Cancel
        </a>
        <button type="submit" class="btn btn-action-blue text-xs px-7 py-3 rounded-xl font-semibold">
          <Save size={16} />
          <span>Save & Publish Property</span>
        </button>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  import L from 'leaflet';

  L.Icon.Default.imagePath = 'https://unpkg.com/leaflet@1.9.4/dist/images/';

  const initMapPicker = () => {
    const mapEl = document.getElementById('admin-map-picker');
    const latInput = document.getElementById('latitude') as HTMLInputElement | null;
    const lngInput = document.getElementById('longitude') as HTMLInputElement | null;

    if (!mapEl || !latInput || !lngInput) return;
    if ((mapEl as any)._leaflet_id) return;

    const initialLat = parseFloat(latInput.value) || 28.628;
    const initialLng = parseFloat(lngInput.value) || 77.3649;

    const map = L.map(mapEl).setView([initialLat, initialLng], 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap',
    }).addTo(map);

    const marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

    const updateInputs = (lat: number, lng: number) => {
      latInput.value = lat.toFixed(6);
      lngInput.value = lng.toFixed(6);
    };

    marker.on('dragend', (e) => {
      const position = e.target.getLatLng();
      updateInputs(position.lat, position.lng);
    });

    map.on('click', (e) => {
      marker.setLatLng(e.latlng);
      updateInputs(e.latlng.lat, e.latlng.lng);
    });

    const onInputChange = () => {
      const lat = parseFloat(latInput.value);
      const lng = parseFloat(lngInput.value);
      if (!isNaN(lat) && !isNaN(lng)) {
        const newLatLng = L.latLng(lat, lng);
        marker.setLatLng(newLatLng);
        map.panTo(newLatLng);
      }
    };

    latInput.addEventListener('change', onInputChange);
    lngInput.addEventListener('change', onInputChange);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMapPicker);
  } else {
    initMapPicker();
  }
</script>
