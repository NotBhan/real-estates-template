---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Maa Laxmi Property Consultant.">
  <div class="pt-28 pb-12 bg-bg-primary">
    <div class="container-site">
      <p class="kicker mb-3">Get in Touch</p>
      <h1 class="heading-section--light heading-section">Contact Us</h1>
    </div>
  </div>
  <div class="container-site section-padding">
    <p class="text-body max-w-2xl">
      Contact form, map integration, and WhatsApp/Call actions will be
      implemented in Milestone 3.
    </p>
  </div>
</BaseLayout>
