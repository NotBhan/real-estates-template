---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/hero/Hero.astro';
import PropertySearchForm from '@components/search/PropertySearchForm.astro';
import FeaturedProperties from '@components/sections/FeaturedProperties.astro';
import PropertyCategories from '@components/property/PropertyCategories.astro';
import TrustTicker from '@components/sections/TrustTicker.astro';
import ArchitecturalStatement from '@components/sections/ArchitecturalStatement.astro';
---

<BaseLayout title="Home">
  {/* 1. Cinematic Scroll Hero */}
  <Hero />

  {/* 2. Floating Search Interface */}
  <section class="px-4 sm:px-6 bg-canvas pb-12 relative z-20">
    <PropertySearchForm variant="hero" />
  </section>

  {/* 3. Continuous Trust Marquee */}
  <TrustTicker />

  {/* 4. Editorial Featured Showcase */}
  <FeaturedProperties />

  {/* 5. Category Asset Classes */}
  <PropertyCategories variant="homepage" />

  {/* 6. Strategic Dark Architectural Statement */}
  <ArchitecturalStatement />
</BaseLayout>
