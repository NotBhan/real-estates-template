---
import BaseLayout from '@layouts/BaseLayout.astro';
import { config } from '@/lib/config';
import { ShieldCheck, ArrowLeft } from '@lucide/astro';
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy policy and demonstration notice for ${config.siteName}.`}
>
  <div class="pt-28 sm:pt-32 pb-16 bg-canvas border-b border-stone-200/80">
    <div class="container-site max-w-4xl">
      <a href="/" class="inline-flex items-center gap-2 text-muted hover:text-action-blue text-xs font-semibold uppercase tracking-wider mb-6 transition-colors">
        <ArrowLeft size={14} />
        <span>Return to Home</span>
      </a>

      <div class="eyebrow-label mb-3">
        <ShieldCheck size={14} class="text-brand-gold" />
        <span>Legal Documentation</span>
      </div>
      <h1 class="heading-editorial text-4xl sm:text-5xl font-bold tracking-tight text-ink mb-4">
        Privacy <span class="font-normal italic text-stone-500">Policy</span>
      </h1>
      <p class="text-muted text-base font-light">
        Demonstration disclosure and client data protection principles for {config.siteName}.
      </p>
    </div>
  </div>

  <div class="section-padding bg-white">
    <div class="container-site max-w-4xl prose prose-stone">
      <div class="bg-amber-50/70 border border-amber-200/80 rounded-2xl p-6 mb-10 text-sm text-stone-800 not-prose">
        <p class="font-bold text-amber-900 mb-1">Demonstration Template Disclosure</p>
        <p class="font-light leading-relaxed">
          {config.demoDisclosure} All mock inquiries submitted through this website are processed locally in demonstration mode for presentation purposes.
        </p>
      </div>

      <div class="space-y-8 text-stone-700 text-sm sm:text-base font-light leading-relaxed">
        <section>
          <h2 class="text-xl font-bold text-ink mb-3 font-sans">1. Information Collection & Demonstration Context</h2>
          <p>
            When utilizing this demonstration website, visitors may enter test information into property inquiry forms or the interactive assistant. In this demonstration deployment, submissions are stored in temporary application memory or local storage solely for demonstrating end-to-end functionality.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-ink mb-3 font-sans">2. Client Confidentiality Commitment</h2>
          <p>
            In production deployments configured for an operating agency, real estate inquiries are handled with strict commercial confidentiality. Client contact details, budget criteria, and viewing schedules are routed directly to licensed property consultants and are never distributed to unverified third parties.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-ink mb-3 font-sans">3. Cookies & Session Storage</h2>
          <p>
            This website utilizes minimal session cookies necessary for authenticated administrative CMS demonstration and interface state preservation. We do not employ third-party tracking pixels or persistent advertising beacons.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-ink mb-3 font-sans">4. Contact & Inquiries</h2>
          <p>
            To customize this template or enquire about production deployment for your real-estate agency, visit our <a href="/contact" class="text-action-blue font-semibold hover:underline">Contact Advisory page</a>.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
