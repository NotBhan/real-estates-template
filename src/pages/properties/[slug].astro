---
import BaseLayout from '@layouts/BaseLayout.astro';
import { config } from '@/lib/config';
import { getPropertyBySlug, getAllProperties } from '@/data/demo-properties';
import { ArrowLeft } from '@lucide/astro';

import PropertyHero from '@components/property/PropertyHero.astro';
import PropertyInfo from '@components/property/PropertyInfo.astro';
import PropertyOverview from '@components/property/PropertyOverview.astro';
import PropertyGallery from '@components/property/PropertyGallery.astro';
import PropertyEnquiry from '@components/property/PropertyEnquiry.astro';
import PropertyMap from '@components/property/PropertyMap.astro';
import PropertyCard from '@components/property/PropertyCard.astro';

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404 });
}

const property = getPropertyBySlug(slug);

if (!property) {
  Astro.response.status = 404;
}

const ogImage = property?.images[0]?.url;
const description = property?.description?.slice(0, 155) + '...';

const allProperties = getAllProperties();
const relatedProperties = property
  ? allProperties
      .filter((p) => p.id !== property.id)
      .sort((a, b) => {
        // Prioritize same propertyType
        if (a.propertyType === property.propertyType && b.propertyType !== property.propertyType) return -1;
        if (b.propertyType === property.propertyType && a.propertyType !== property.propertyType) return 1;
        // Then same listingType
        if (a.listingType === property.listingType && b.listingType !== property.listingType) return -1;
        if (b.listingType === property.listingType && a.listingType !== property.listingType) return 1;
        return 0;
      })
      .slice(0, 3)
  : [];
---

<BaseLayout 
  title={property ? `${property.title} | ${config.siteName}` : 'Property Not Found'} 
  description={description || "Property detail page"}
  ogImage={ogImage}
>
  {!property ? (
    <div class="pt-32 pb-24 bg-canvas min-h-[70vh] flex items-center">
      <div class="container-site w-full">
        <div class="text-center py-20 bg-white rounded-3xl border border-stone-200 shadow-sm max-w-xl mx-auto p-8">
          <h1 class="text-ink text-3xl font-bold mb-4">Property Not Found</h1>
          <p class="text-muted mb-8 font-light">The property you are looking for does not exist or has been removed.</p>
          <a href="/properties" class="btn btn-action-blue px-7 py-3 rounded-full">Back to Properties</a>
        </div>
      </div>
    </div>
  ) : (
    <div class="bg-canvas pb-16">
      {/* Back Navigation */}
      <div class="container-site pt-24 md:pt-28 pb-4">
        <a href="/properties" class="inline-flex items-center gap-2 text-muted hover:text-action-blue text-sm font-semibold transition-colors no-underline group">
          <ArrowLeft size={16} class="transform group-hover:-translate-x-1 transition-transform text-action-blue" />
          <span>Back to All Properties</span>
        </a>
      </div>

      {/* Detail Page Components */}
      <PropertyHero property={property} />
      <PropertyInfo property={property} />
      <PropertyOverview property={property} />
      <PropertyMap
        title={property.title}
        address={property.location.address}
        locality={property.location.locality}
        city={property.location.city}
        latitude={property.location.latitude}
        longitude={property.location.longitude}
      />
      {property.images && property.images.length > 1 && (
        <PropertyGallery images={property.images} propertyTitle={property.title} />
      )}
      <PropertyEnquiry propertyTitle={property.title} propertySlug={property.slug} />

      {/* Related Properties */}
      {relatedProperties.length > 0 && (
        <section class="section-padding border-t border-stone-200/80 bg-canvas relative overflow-hidden" aria-labelledby="related-heading">
          <div class="container-site">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
              <div>
                <div class="eyebrow-label mb-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
                  <span>Similar Opportunities</span>
                </div>
                <h2 class="heading-section text-3xl font-bold tracking-tight text-ink" id="related-heading">
                  Related <span class="font-normal italic text-stone-500">Properties</span>
                </h2>
              </div>
              <a href="/properties" class="btn btn-stone-outline text-xs px-5 py-2.5 rounded-full font-semibold">
                Explore Full Catalogue &rarr;
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {relatedProperties.map((relProp) => (
                <div class="h-full flex flex-col">
                  <PropertyCard property={relProp} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
  )}
</BaseLayout>
