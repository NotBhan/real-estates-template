---
import BaseLayout from '@layouts/BaseLayout.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import PropertyCategories from '@components/property/PropertyCategories.astro';
import PropertySearchForm from '@components/search/PropertySearchForm.astro';
import { getAllProperties } from '@/data/demo-properties';
import { parseFilterParams, filterProperties } from '@/lib/property-filters';
import { X, SlidersHorizontal } from '@lucide/astro';

// Parse query params and filter
const filters = parseFilterParams(Astro.url);
const allProperties = getAllProperties();
const filteredProperties = filterProperties(allProperties, filters);
const count = filteredProperties.length;

// Compute active filters for the summary
const activeFilters = [];
if (filters.q) activeFilters.push({ label: `"${filters.q}"`, key: 'q' });
if (filters.listing) activeFilters.push({ label: `For ${filters.listing}`, key: 'listing' });
if (filters.minPrice && !filters.maxPrice) activeFilters.push({ label: `₹${filters.minPrice.toLocaleString('en-IN')}+`, key: 'minPrice' });
if (!filters.minPrice && filters.maxPrice) activeFilters.push({ label: `Up to ₹${filters.maxPrice.toLocaleString('en-IN')}`, key: 'maxPrice' });
if (filters.minPrice && filters.maxPrice) activeFilters.push({ label: `₹${filters.minPrice.toLocaleString('en-IN')} - ₹${filters.maxPrice.toLocaleString('en-IN')}`, key: 'price' });

function getRemoveFilterUrl(keyToRemove: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (keyToRemove === 'price') {
    params.delete('minPrice');
    params.delete('maxPrice');
  } else {
    params.delete(keyToRemove);
  }
  return `/properties?${params.toString()}`;
}
---

<BaseLayout title="Properties" description="Browse residential, commercial, land, and rental properties.">
  {/* Header */}
  <div class="pt-28 pb-12 bg-bg-primary">
    <div class="container-site">
      <p class="kicker mb-3">Our Listings</p>
      <h1 class="heading-section--light heading-section">Properties</h1>
    </div>
  </div>

  <div class="bg-bg-primary pb-20 min-h-[50vh]">
    <div class="container-site">
      {/* Categories / Tabs */}
      <PropertyCategories variant="filter" />

      {/* Filter & Meta Bar */}
      <div class="mb-8 space-y-4">
        {/* Advanced Search Toggle (Details/Summary) */}
        <details class="group bg-bg-dark border border-border rounded-xl">
          <summary class="flex justify-between items-center p-4 cursor-pointer list-none focus-visible:outline-accent">
            <div class="flex items-center gap-3">
              <SlidersHorizontal size={20} class="text-accent" />
              <span class="font-medium text-white">Filter Properties</span>
            </div>
            <span class="text-text-light transition-transform duration-300 group-open:rotate-180">
              ▼
            </span>
          </summary>
          <div class="p-4 border-t border-border">
            <PropertySearchForm variant="default" />
          </div>
        </details>

        {/* Active Filters & Count */}
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <p class="text-text-light text-sm font-medium whitespace-nowrap">
            Showing {count} {count === 1 ? 'property' : 'properties'}
          </p>

          {activeFilters.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs text-text-light uppercase tracking-wider font-semibold mr-1">Active Filters:</span>
              {activeFilters.map((filter) => (
                <a
                  href={getRemoveFilterUrl(filter.key)}
                  class="flex items-center gap-1.5 px-3 py-1 bg-white/5 border border-border rounded-full text-sm text-white hover:bg-white/10 hover:border-accent transition-colors focus-visible:outline-accent no-underline"
                >
                  {filter.label}
                  <X size={14} class="text-text-light" />
                </a>
              ))}
              <a
                href="/properties"
                class="text-sm text-accent hover:text-white underline-offset-4 hover:underline ml-2 transition-colors"
              >
                Clear all
              </a>
            </div>
          )}
        </div>
      </div>

      {/* Grid */}
      {count > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {filteredProperties.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>
      ) : (
        <div class="text-center py-24 border border-border border-dashed rounded-xl bg-bg-dark/30">
          <p class="text-white text-lg font-medium mb-2">No matching properties found</p>
          <p class="text-text-light mb-6">
            We couldn't find any properties matching your current search criteria.
          </p>
          <a href="/properties" class="btn btn-outline px-6 py-2">
            Clear all filters
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
