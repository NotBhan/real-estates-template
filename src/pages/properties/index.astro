---
import BaseLayout from '@layouts/BaseLayout.astro';
import PropertyCard from '@components/property/PropertyCard.astro';
import PropertyCategories from '@components/property/PropertyCategories.astro';
import PropertySearchForm from '@components/search/PropertySearchForm.astro';
import { getAllProperties } from '@/data/demo-properties';
import { parseFilterParams, filterProperties } from '@/lib/property-filters';
import { X, SlidersHorizontal } from '@lucide/astro';

// Parse query params and filter
const filters = parseFilterParams(Astro.url);
const allProperties = getAllProperties();
const filteredProperties = filterProperties(allProperties, filters);
const count = filteredProperties.length;

// Compute active filters for the summary
const activeFilters = [];
if (filters.q) activeFilters.push({ label: `"${filters.q}"`, key: 'q' });
if (filters.listing) activeFilters.push({ label: `For ${filters.listing}`, key: 'listing' });
if (filters.minPrice && !filters.maxPrice) activeFilters.push({ label: `₹${filters.minPrice.toLocaleString('en-IN')}+`, key: 'minPrice' });
if (!filters.minPrice && filters.maxPrice) activeFilters.push({ label: `Up to ₹${filters.maxPrice.toLocaleString('en-IN')}`, key: 'maxPrice' });
if (filters.minPrice && filters.maxPrice) activeFilters.push({ label: `₹${filters.minPrice.toLocaleString('en-IN')} - ₹${filters.maxPrice.toLocaleString('en-IN')}`, key: 'price' });

function getRemoveFilterUrl(keyToRemove: string) {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (keyToRemove === 'price') {
    params.delete('minPrice');
    params.delete('maxPrice');
  } else {
    params.delete(keyToRemove);
  }
  return `/properties?${params.toString()}`;
}
---

<BaseLayout title="Properties" description="Browse residential, commercial, land, and rental properties." darkBody>
  {/* Header */}
  <div class="pt-32 pb-16 bg-bg-primary relative overflow-hidden">
    <div class="absolute top-0 right-1/4 w-[400px] h-[400px] bg-blue-600/15 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="container-site relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-surface text-blue-400 border border-blue-500/20 text-xs font-semibold uppercase tracking-[0.15em] mb-4">
        Catalogue Overview
      </div>
      <h1 class="text-gradient-silver font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight mb-4">
        Explore <span class="text-gradient-electric">Properties</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg max-w-2xl font-light">
        Discover handpicked residential homes, commercial complexes, and investment land holdings across Delhi NCR.
      </p>
    </div>
  </div>

  <div class="bg-bg-primary pb-24 min-h-[50vh]">
    <div class="container-site">
      {/* Categories / Tabs */}
      <PropertyCategories variant="filter" />

      {/* Filter & Meta Bar */}
      <div class="mb-10 space-y-5">
        {/* Advanced Search Toggle */}
        <details class="group glass-card rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex justify-between items-center p-5 cursor-pointer list-none focus-visible:outline-none">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
                <SlidersHorizontal size={18} />
              </div>
              <span class="font-semibold text-white text-base">Filter & Refine Catalogue</span>
            </div>
            <span class="text-slate-400 transition-transform duration-300 group-open:rotate-180 text-sm">
              ▼
            </span>
          </summary>
          <div class="p-6 border-t border-white/10 bg-slate-950/40">
            <PropertySearchForm variant="default" />
          </div>
        </details>

        {/* Active Filters & Count */}
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
          <p class="text-slate-400 text-sm font-medium whitespace-nowrap">
            Showing <span class="text-white font-semibold">{count}</span> {count === 1 ? 'property' : 'properties'}
          </p>

          {activeFilters.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold mr-1">Active Filters:</span>
              {activeFilters.map((filter) => (
                <a
                  href={getRemoveFilterUrl(filter.key)}
                  class="flex items-center gap-2 px-3.5 py-1.5 glass-surface border border-blue-500/30 rounded-full text-xs font-medium text-blue-300 hover:bg-blue-500/10 transition-colors no-underline"
                >
                  {filter.label}
                  <X size={13} class="text-slate-400 hover:text-white" />
                </a>
              ))}
              <a
                href="/properties"
                class="text-xs font-semibold text-blue-400 hover:text-blue-300 underline-offset-4 hover:underline ml-2 transition-colors"
              >
                Clear all
              </a>
            </div>
          )}
        </div>
      </div>

      {/* Grid */}
      {count > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {filteredProperties.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>
      ) : (
        <div class="text-center py-24 border border-white/10 border-dashed rounded-3xl glass-surface">
          <p class="text-white text-xl font-bold mb-2">No matching properties found</p>
          <p class="text-slate-400 mb-8 max-w-md mx-auto font-light">
            We couldn't find any properties matching your current search criteria. Try adjusting your filters.
          </p>
          <a href="/properties" class="btn btn-electric px-7 py-3 text-sm rounded-xl">
            Clear all filters
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
