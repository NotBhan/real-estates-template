---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Services" description="Property buying, selling, renting, and consultation services.">
  <div class="pt-28 sm:pt-32 pb-12 sm:pb-16 bg-canvas border-b border-stone-200/80">
    <div class="container-site">
      <div class="eyebrow-label mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
        <span>What We Do</span>
      </div>
      <h1 class="heading-editorial text-4xl sm:text-5xl md:text-6xl tracking-tight mb-4 text-ink">
        Our Services
      </h1>
      <p class="text-muted text-base md:text-lg max-w-2xl font-light">
        End-to-end real estate advisory across acquisition, disposition, leasing, and strategic land investments.
      </p>
    </div>
  </div>
  <div class="bg-canvas section-padding">
    <div class="container-site">
      <div class="bg-white border border-stone-200 rounded-3xl p-8 sm:p-12 max-w-3xl shadow-sm">
        <p class="text-muted text-lg leading-relaxed font-light mb-6">
          Detailed service specifications will be finalized with client confirmation.
        </p>
        <p class="text-muted text-base leading-relaxed font-light">
          Scope covers luxury residential sales, commercial leasing, land parcel acquisitions, and investment portfolio consultation in Gurugram & Delhi NCR.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
