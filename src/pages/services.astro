---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Services" description="Property buying, selling, renting, and consultation services.">
  <div class="pt-28 pb-12 bg-bg-primary">
    <div class="container-site">
      <p class="kicker mb-3">What We Do</p>
      <h1 class="heading-section--light heading-section">Our Services</h1>
    </div>
  </div>
  <div class="container-site section-padding">
    <p class="text-body max-w-2xl">
      Service details will be finalized with client confirmation.
      This page will cover property buying, selling, renting, and consultation services.
    </p>
  </div>
</BaseLayout>
